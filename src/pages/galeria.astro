---
import Layout from '../layouts/Layout.astro';
import Nav    from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const tattoos = Array.from({ length: 26 }, (_, i) => ({
  src: `/images/gallery/tattoo-${String(i + 1).padStart(2, '0')}.webp`,
  alt: `Tatuaje ${i + 1}`,
}));
---

<Layout title="Galería — Coyote Tattoo" description="Todos los trabajos de Coyote Tattoo. Tatuajes únicos hechos a medida en Alcobendas, Madrid.">
  <Nav />

  <main style="padding: 0 24px 80px; max-width: 1200px; margin: 0 auto;">

    <!-- Page header -->
    <div style="padding: 100px 0 48px;" class="reveal">
      <p style="
        font-family: 'Inter', system-ui, sans-serif;
        font-size: 12px; font-weight: 500;
        letter-spacing: -0.01em; color: #9B4DCA;
        margin-bottom: 12px;
      ">Galería</p>
      <h1 style="
        font-family: 'Bebas Neue', Impact, sans-serif;
        font-size: clamp(40px, 7vw, 72px); font-weight: 400;
        line-height: 1; letter-spacing: 0.04em; color: #000; margin: 0 0 16px;
      ">Todo el trabajo</h1>
      <p style="
        font-family: 'Lora', Georgia, serif;
        font-size: 18px; color: #9b9b9b; line-height: 1.6;
        max-width: 500px;
      ">Sin plantillas, sin catálogos. Cada uno de estos tatuajes nació de una conversación con Marta.</p>
      <div style="width: 48px; height: 3px; background: #9B4DCA; margin-top: 24px; border-radius: 2px;"></div>
    </div>

    <!-- Masonry-style grid -->
    <div class="gallery-grid">
      {tattoos.map((t, i) => (
        <div class="gallery-item reveal" data-index={i}
             role="button" tabindex="0"
             aria-label={`Ver ${t.alt}`}
             style="cursor: pointer;">
          <div class="img-frame" style="overflow: hidden;">
            <img src={t.src} alt={t.alt}
                 loading={i < 6 ? 'eager' : 'lazy'}
                 style="width: 100%; height: auto; display: block;" />
          </div>
        </div>
      ))}
    </div>

    <!-- WhatsApp CTA -->
    <div style="text-align: center; margin-top: 64px;" class="reveal">
      <p style="
        font-family: 'Bebas Neue', Impact, sans-serif;
        font-size: 28px; letter-spacing: 0.03em; color: #000; margin-bottom: 16px;
      ">¿Tienes algo en mente?</p>
      <a href="https://wa.me/34611411420?text=Hola,%20me%20gustaría%20consultar%20sobre%20un%20tatuaje"
         target="_blank" rel="noopener"
         class="btn-ghost" style="border-color: #9B4DCA; color: #9B4DCA;">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        Cuéntanoslo
      </a>
    </div>
  </main>

  <Footer />
</Layout>

<!-- Lightbox -->
<div id="lightbox" style="
  position: fixed; inset: 0; z-index: 100;
  background: rgba(0,0,0,0.95);
  display: flex; align-items: center; justify-content: center;
  opacity: 0; pointer-events: none;
  transition: opacity 0.25s ease;
">
  <button id="lb-close" aria-label="Cerrar" style="
    position: absolute; top: 20px; right: 24px;
    background: none; border: none; cursor: pointer;
    font-family: 'Lora', Georgia, serif; font-size: 16px; color: #9b9b9b;
  ">Cerrar ×</button>

  <button id="lb-prev" aria-label="Anterior" style="
    position: absolute; left: 20px;
    background: none; border: none; cursor: pointer; padding: 8px;
  ">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.5">
      <path d="M15 19l-7-7 7-7"/>
    </svg>
  </button>

  <img id="lb-img" src="" alt="" style="
    max-height: 85vh; max-width: 80vw; object-fit: contain;
    border-radius: 10px;
  "/>

  <button id="lb-next" aria-label="Siguiente" style="
    position: absolute; right: 20px;
    background: none; border: none; cursor: pointer; padding: 8px;
  ">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.5">
      <path d="M9 5l7 7-7 7"/>
    </svg>
  </button>

  <p id="lb-count" style="
    position: absolute; bottom: 20px;
    font-family: 'Lora', Georgia, serif; font-size: 16px; color: #9B4DCA;
    letter-spacing: -0.14px;
  "></p>
</div>

<style>
  .gallery-grid {
    display: columns;
    columns: 3;
    column-gap: 16px;
  }
  .gallery-item {
    break-inside: avoid;
    margin-bottom: 16px;
  }
  .gallery-item .img-frame {
    transition: transform 0.3s ease;
  }
  .gallery-item:hover .img-frame {
    transform: scale(1.01);
  }
  .btn-ghost:hover {
    background: #9B4DCA !important;
    color: #fff !important;
    border-color: #9B4DCA !important;
  }
  @media (max-width: 900px) {
    .gallery-grid { columns: 2; }
  }
  @media (max-width: 500px) {
    .gallery-grid { columns: 1; column-gap: 12px; }
    .gallery-item { margin-bottom: 12px; }
  }
</style>

<script>
  const items = Array.from(document.querySelectorAll('[data-index]'));
  const imgs = items.map(el => (el.querySelector('img') as HTMLImageElement).src);
  let cur = 0;
  const lb    = document.getElementById('lightbox')!;
  const lbImg = document.getElementById('lb-img') as HTMLImageElement;
  const lbCnt = document.getElementById('lb-count')!;

  function openLb(i: number) {
    cur = i;
    lbImg.src = imgs[cur];
    lbCnt.textContent = `${cur + 1} / ${imgs.length}`;
    lb.style.opacity = '1';
    lb.style.pointerEvents = 'all';
    document.body.style.overflow = 'hidden';
  }
  function closeLb() {
    lb.style.opacity = '0';
    lb.style.pointerEvents = 'none';
    document.body.style.overflow = '';
  }
  function prev() { openLb((cur - 1 + imgs.length) % imgs.length); }
  function next() { openLb((cur + 1) % imgs.length); }

  items.forEach(el => {
    const i = parseInt((el as HTMLElement).dataset.index!);
    el.addEventListener('click', () => openLb(i));
    el.addEventListener('keydown', (e) => { if ((e as KeyboardEvent).key === 'Enter') openLb(i); });
  });

  document.getElementById('lb-close')!.addEventListener('click', closeLb);
  document.getElementById('lb-prev')!.addEventListener('click', prev);
  document.getElementById('lb-next')!.addEventListener('click', next);
  lb.addEventListener('click', (e) => { if (e.target === lb) closeLb(); });
  document.addEventListener('keydown', (e) => {
    if (lb.style.opacity === '0') return;
    if (e.key === 'Escape') closeLb();
    if (e.key === 'ArrowLeft') prev();
    if (e.key === 'ArrowRight') next();
  });
</script>

<!-- Reveal on scroll -->
<script>
  const obs = new IntersectionObserver(
    (entries) => entries.forEach(e => {
      if (e.isIntersecting) e.target.classList.add('visible');
    }),
    { threshold: 0.08, rootMargin: '0px 0px -32px 0px' }
  );
  document.querySelectorAll('.reveal').forEach(el => obs.observe(el));
</script>
