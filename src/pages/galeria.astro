---
import Layout from '../layouts/Layout.astro';
import Nav    from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { getCachedPosts } from '../lib/instagram';

const instagramPosts = await getCachedPosts(120);
const useInstagram = instagramPosts.length > 0;

const fallbackAlts = [
  'Tatuaje realismo catrina rezando en brazo — Coyote Tattoo Alcobendas',
  'Tatuaje guerrero con tocado de oso en brazo — Coyote Tattoo Alcobendas',
  'Tatuaje tradicional serpiente con rosa y lettering Trust No One en antebrazo — Coyote Tattoo Alcobendas',
  'Tatuaje realismo aguila con alas abiertas en espalda — Coyote Tattoo Alcobendas',
  'Tatuaje realismo catrina con dedo en labios en pierna — Coyote Tattoo Alcobendas',
  'Fachada del estudio Coyote Tattoo en Calle Real Vieja, Alcobendas',
  'Tatuaje reloj de bolsillo con lettering en antebrazo — Coyote Tattoo Alcobendas',
  'Tatuaje retrato realista de bebe con pompas de jabon en hombro — Coyote Tattoo Alcobendas',
  'Tatuaje botanico crisantemos y mariposa en cadera — Coyote Tattoo Alcobendas',
  'Tatuaje rosa realista con nombre Lola en mano — Coyote Tattoo Alcobendas',
  'Tatuaje rosa roja a color en costillas — Coyote Tattoo Alcobendas',
  'Tatuaje tribal mariposa blackwork en zona lumbar — Coyote Tattoo Alcobendas',
  'Tatuaje realismo mujer steampunk con mascara de gas en pierna — Coyote Tattoo Alcobendas',
  'Tatuaje tela de arana en codo con lettering Mundana — Coyote Tattoo Alcobendas',
  'Tatuaje fine line corona de laurel con fecha en antebrazo — Coyote Tattoo Alcobendas',
  'Tatuaje blackwork cabeza de demonio con cuernos en muslo — Coyote Tattoo Alcobendas',
  'Tatuaje blackwork tribal con motivo de corazon en pecho — Coyote Tattoo Alcobendas',
  'Tatuaje lettering nombres Isaac y Natalia en munecas — Coyote Tattoo Alcobendas',
  'Tatuaje blackwork brazalete geometrico con lineas y X en antebrazo — Coyote Tattoo Alcobendas',
  'Tatuajes a juego silueta de pais fine line en tobillos — Coyote Tattoo Alcobendas',
  'Tatuaje realismo ala con plumas en antebrazo — Coyote Tattoo Alcobendas',
  'Tatuajes minimalistas pajaro fine line a juego — Coyote Tattoo Alcobendas',
  'Tatuaje bandera cubana estilo acuarela a color en hombro — Coyote Tattoo Alcobendas',
  'Tatuaje fine line corazon con caracteres japoneses y numeros romanos — Coyote Tattoo Alcobendas',
  'Tatuaje fine line estrella de mar y caracola en costado — Coyote Tattoo Alcobendas',
  'Tatuaje fine line cedro en pecho — Coyote Tattoo Alcobendas',
];

const tattoos = useInstagram
  ? instagramPosts.map((post, i) => ({
      src: post.media_url,
      alt: `Tatuaje de Coyote Tattoo Alcobendas ${i + 1}`,
    }))
  : fallbackAlts.map((alt, i) => ({
      src: `/images/gallery/tattoo-${String(i + 1).padStart(2, '0')}.webp`,
      alt,
    }));
---

<Layout title="Galería — Coyote Tattoo" description="Galería de tatuajes de Coyote Tattoo en Alcobendas. Realismo, blackwork, fine line, color y lettering. Cada diseño es único, hecho a medida por Marta.">
  <Nav />

  <main id="main-content" class="galeria-main">

    <!-- Page header -->
    <div class="page-header reveal">
      <p class="page-header__label">Galería</p>
      <h1 class="page-header__title">Todo el trabajo</h1>
      <p class="page-header__desc">Sin plantillas, sin catálogos. Cada uno de estos tatuajes nació de una conversación con Marta.</p>
      <div class="page-header__accent"></div>
    </div>

    <!-- Filter tabs -->
    <div class="filter-bar reveal" role="tablist" aria-label="Filtrar por estilo">
      <button class="filter-tab active" data-filter="todos" role="tab" aria-selected="true">Todos</button>
      <button class="filter-tab" data-filter="realismo" role="tab" aria-selected="false">Realismo</button>
      <button class="filter-tab" data-filter="blackwork" role="tab" aria-selected="false">Blackwork</button>
      <button class="filter-tab" data-filter="color" role="tab" aria-selected="false">Color</button>
      <button class="filter-tab" data-filter="fine-line" role="tab" aria-selected="false">Fine Line</button>
      <button class="filter-tab" data-filter="lettering" role="tab" aria-selected="false">Lettering</button>
    </div>

    <!-- Instagram source label -->
    {useInstagram && (
      <p class="instagram-label reveal">Últimos trabajos · actualizado desde Instagram</p>
    )}

    <!-- Masonry-style grid -->
    <div class="gallery-grid">
      {tattoos.map((t, i) => (
        <div class="gallery-item reveal" data-index={i} data-style="todos"
             role="button" tabindex="0"
             aria-label={`Ver ${t.alt}`}>
          <div class="img-frame">
            <img src={t.src} alt={t.alt}
                 loading={i < 6 ? 'eager' : 'lazy'}
                 class="gallery-item__img" />
          </div>
        </div>
      ))}
    </div>

    <!-- WhatsApp CTA -->
    <div class="galeria-cta reveal">
      <p class="galeria-cta__title">¿Tienes algo en mente?</p>
      <a href="https://wa.me/34611411420?text=%C2%A1Hola!%20Vengo%20desde%20vuestra%20web%20y%20quiero%20info%20para%20un%20tatuaje%20%F0%9F%99%8C%20Zona%3A%20__%20%C2%B7%20%C2%BFReferencia%3F%20S%C3%AD%2FNo.%20%C2%A1Gracias!"
         target="_blank" rel="noopener"
         class="btn-ghost--accent btn-ghost"
         data-wa-src="galeria">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        Cuéntanoslo
      </a>
    </div>
  </main>

  <Footer />
</Layout>

<!-- Lightbox -->
<div id="lightbox" class="lightbox">
  <button id="lb-close" class="lightbox__close" aria-label="Cerrar">Cerrar &times;</button>

  <button id="lb-prev" class="lightbox__nav lightbox__nav--prev" aria-label="Anterior">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.5">
      <path d="M15 19l-7-7 7-7"/>
    </svg>
  </button>

  <img id="lb-img" class="lightbox__img" src="" alt="" />

  <button id="lb-next" class="lightbox__nav lightbox__nav--next" aria-label="Siguiente">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.5">
      <path d="M9 5l7 7-7 7"/>
    </svg>
  </button>

  <p id="lb-count" class="lightbox__count"></p>
</div>

<style>
  /* ── Gallery main container ────────────────────────── */
  .galeria-main {
    padding: 0 24px 80px;
    max-width: 1200px;
    margin: 0 auto;
  }

  /* ── Masonry grid ──────────────────────────────────── */
  .gallery-grid {
    display: block;
    columns: 3;
    column-gap: 16px;
  }

  .gallery-item {
    break-inside: avoid;
    margin-bottom: 16px;
    cursor: pointer;
  }

  .gallery-item .img-frame {
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    transition: border-color 0.3s ease;
  }

  .gallery-item:hover .img-frame {
    border-color: var(--color-accent);
  }

  .gallery-item__img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    transition: transform 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .gallery-item:hover .gallery-item__img {
    transform: scale(1.03);
  }

  /* ── Instagram label ───────────────────────────────── */
  .instagram-label {
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 500;
    color: var(--color-text-secondary);
    letter-spacing: 0.02em;
    margin-bottom: 20px;
    text-align: center;
  }

  /* ── CTA section ───────────────────────────────────── */
  .galeria-cta {
    text-align: center;
    margin-top: 64px;
  }

  .galeria-cta__title {
    font-family: var(--font-wordmark);
    font-size: 28px;
    letter-spacing: 0.03em;
    color: var(--color-text-primary);
    margin-bottom: 16px;
  }

  /* ── Lightbox ──────────────────────────────────────── */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 100;
    background: rgba(0, 0, 0, 0.95);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease;
  }

  .lightbox.is-open {
    opacity: 1;
    pointer-events: all;
  }

  .lightbox__close {
    position: absolute;
    top: max(20px, env(safe-area-inset-top));
    right: 24px;
    background: none;
    border: none;
    cursor: pointer;
    font-family: var(--font-serif);
    font-size: 16px;
    color: var(--color-text-secondary);
    min-width: 44px;
    min-height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lightbox__close:hover {
    color: var(--color-text-primary);
  }

  .lightbox__nav {
    position: absolute;
    background: none;
    border: none;
    cursor: pointer;
    padding: 12px;
    min-width: 48px;
    min-height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lightbox__nav--prev {
    left: 20px;
  }

  .lightbox__nav--next {
    right: 20px;
  }

  .lightbox__nav:hover svg {
    stroke: var(--color-accent-light);
  }

  .lightbox__img {
    max-height: 85vh;
    max-width: 80vw;
    object-fit: contain;
    border-radius: var(--radius-card);
  }

  .lightbox__count {
    position: absolute;
    bottom: 20px;
    font-family: var(--font-serif);
    font-size: 16px;
    color: var(--color-accent);
    letter-spacing: -0.14px;
  }

  /* ── Filter bar ─────────────────────────────────────── */
  .filter-bar {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 40px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--color-border);
  }
  .filter-tab {
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 500;
    padding: 10px 18px;
    min-height: 44px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-border);
    background: transparent;
    color: var(--color-text-secondary);
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .filter-tab:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
  .filter-tab.active {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: #fff;
  }

  .gallery-item {
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  /* ── Responsive ────────────────────────────────────── */
  @media (max-width: 900px) {
    .gallery-grid {
      columns: 2;
    }
  }

  @media (max-width: 500px) {
    .gallery-grid {
      columns: 1;
      column-gap: 12px;
    }
    .gallery-item {
      margin-bottom: 12px;
    }
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const items = Array.from(document.querySelectorAll('[data-index]'));
    const imgs = items.map(el => (el.querySelector('img') as HTMLImageElement).src);
    let cur = 0;
    const lb    = document.getElementById('lightbox')!;
    const lbImg = document.getElementById('lb-img') as HTMLImageElement;
    const lbCnt = document.getElementById('lb-count')!;

    function openLb(i: number) {
      cur = i;
      lbImg.src = imgs[cur];
      lbCnt.textContent = `${cur + 1} / ${imgs.length}`;
      lb.classList.add('is-open');
      document.body.style.overflow = 'hidden';
    }
    function closeLb() {
      lb.classList.remove('is-open');
      document.body.style.overflow = '';
    }
    function prev() { openLb((cur - 1 + imgs.length) % imgs.length); }
    function next() { openLb((cur + 1) % imgs.length); }

    items.forEach(el => {
      const i = parseInt((el as HTMLElement).dataset.index!);
      el.addEventListener('click', () => openLb(i));
      el.addEventListener('keydown', (e) => { if ((e as KeyboardEvent).key === 'Enter') openLb(i); });
    });

    // Filter tabs
    const tabs = document.querySelectorAll('.filter-tab');
    const galleryItems = document.querySelectorAll('.gallery-item');
    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        tabs.forEach(t => { t.classList.remove('active'); t.setAttribute('aria-selected', 'false'); });
        tab.classList.add('active');
        tab.setAttribute('aria-selected', 'true');
        const filter = (tab as HTMLElement).dataset.filter;
        galleryItems.forEach(item => {
          const el = item as HTMLElement;
          const matches = filter === 'todos' || el.dataset.style === filter;
          el.style.opacity = matches ? '1' : '0';
          el.style.transform = matches ? 'scale(1)' : 'scale(0.95)';
          setTimeout(() => { el.style.display = matches ? '' : 'none'; }, 300);
        });
      });
    });

    document.getElementById('lb-close')!.addEventListener('click', closeLb);
    document.getElementById('lb-prev')!.addEventListener('click', prev);
    document.getElementById('lb-next')!.addEventListener('click', next);
    lb.addEventListener('click', (e) => { if (e.target === lb) closeLb(); });
    document.addEventListener('keydown', (e) => {
      if (!lb.classList.contains('is-open')) return;
      if (e.key === 'Escape') closeLb();
      if (e.key === 'ArrowLeft') prev();
      if (e.key === 'ArrowRight') next();
    });

    // Swipe to navigate on mobile
    let swipeStartX = 0;
    let swipeStartY = 0;
    lb.addEventListener('touchstart', (e: TouchEvent) => {
      swipeStartX = e.touches[0].clientX;
      swipeStartY = e.touches[0].clientY;
    }, { passive: true });
    lb.addEventListener('touchend', (e: TouchEvent) => {
      if (!lb.classList.contains('is-open')) return;
      const dx = e.changedTouches[0].clientX - swipeStartX;
      const dy = e.changedTouches[0].clientY - swipeStartY;
      if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) {
        if (dx < 0) next();
        else prev();
      }
    }, { passive: true });
  });
</script>
