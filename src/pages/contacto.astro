---
import Layout from '../layouts/Layout.astro';
import Nav    from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Contacto — Coyote Tattoo" description="Contacta con Coyote Tattoo. Calle Real Vieja 32, Alcobendas, Madrid. Consulta gratuita por WhatsApp.">
  <Nav />

  <main class="contacto-main">

    <!-- Page header -->
    <div class="page-header reveal">
      <p class="page-header__label">Contacto</p>
      <h1 class="page-header__title">Ven a vernos</h1>
      <p class="page-header__desc">Pásate por el estudio o mándanos un WhatsApp. La consulta no cuesta nada.</p>
      <div class="page-header__accent"></div>
    </div>

    <!-- Contact info + map grid -->
    <div class="contact-grid reveal">
      <!-- Left: info -->
      <div>
        <div class="contact-info">
          <div class="contact-info__row contact-info__row--border">
            <p class="contact-info__label">Dirección</p>
            <p class="contact-info__value">Calle Real Vieja, 32<br/>28100 Alcobendas, Madrid</p>
          </div>

          <div class="contact-info__row contact-info__row--border">
            <p class="contact-info__label">Teléfono</p>
            <a href="tel:+34611411420" class="contact-info__link">611 41 14 20</a>
          </div>

          <div class="contact-info__row contact-info__row--border">
            <p class="contact-info__label">Horario</p>
            <p class="contact-info__value">
              Lunes: 16:00–20:30<br/>
              Martes a viernes: 11:00–14:00 / 16:00–20:30<br/>
              Sábado: 11:00–14:00<br/>
              <span class="contact-info__muted">Domingo: Cerrado</span>
            </p>
          </div>

          <div class="contact-info__row">
            <p class="contact-info__label">WhatsApp</p>
            <a href="https://wa.me/34611411420?text=Hola,%20me%20gustaría%20consultar%20sobre%20un%20tatuaje"
               target="_blank" rel="noopener"
               class="btn-ghost--accent btn-ghost contact-info__wa-btn">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
              Escribir por WhatsApp
            </a>
          </div>

          <!-- Badges -->
          <div class="contact-badges">
            <span class="badge">🏳️‍🌈 LGBTQ+ friendly</span>
            <span class="badge">♀ Propietaria mujer</span>
          </div>
        </div>
      </div>

      <!-- Right: Map -->
      <div>
        <div class="img-frame contact-map">
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3033.5!2d-3.6391!3d40.5424!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2sCalle+Real+Vieja+32+Alcobendas!5e0!3m2!1ses!2ses!4v1"
            width="100%" height="400"
            style="border:0; display:block;"
            allowfullscreen
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Ubicación Coyote Tattoo"
          ></iframe>
        </div>
        <p class="contact-map__caption">
          Calle Real Vieja, 32 · Alcobendas ·
          <a href="https://maps.app.goo.gl/1BLkX6jwvPRLCYDfA"
             target="_blank" rel="noopener" class="contact-map__link">
            Ver en Maps →
          </a>
        </p>
      </div>
    </div>

    <!-- Process section -->
    <div class="reveal contact-section">
      <h2 class="section-title contact-section__heading">Cómo funciona</h2>

      <div class="process-grid">
        {[
          {
            n: '01',
            title: 'Consulta',
            desc: 'Mándanos un WhatsApp o ven al estudio. Si tienes una foto de referencia, genial. Si solo tienes una idea a medias, también vale. Marta te ayuda a darle forma y te dice cuánto cuesta.',
          },
          {
            n: '02',
            title: 'Diseño',
            desc: 'Marta te prepara un diseño. Lo ves, le dices qué cambiar, lo ajustamos. Las veces que haga falta. No se tatúa nada hasta que estés 100% convencido.',
          },
          {
            n: '03',
            title: 'Tu cita',
            desc: 'Vienes al estudio, todo está preparado y estéril. Marta te tatúa con calma. Al acabar te explica cómo cuidarlo y te da su número por si tienes cualquier duda.',
          },
        ].map(step => (
          <div class="card process-card">
            <p class="process-card__number">{step.n}</p>
            <p class="process-card__title">{step.title}</p>
            <p class="process-card__desc">{step.desc}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Aftercare section -->
    <div class="reveal aftercare">
      <h2 class="aftercare__title">Cuidado del tatuaje</h2>

      <div class="aftercare-grid">
        <div>
          <h3 class="aftercare__subtitle">Primeras 24-48 horas</h3>
          <ul class="aftercare__list">
            <li>Retira el film protector después de 2-4 horas</li>
            <li>Lava suavemente con agua tibia y jabón neutro (sin frotar)</li>
            <li>Seca con toques suaves usando papel de cocina limpio</li>
            <li>Aplica una capa fina de crema cicatrizante (Bepanthen o similar)</li>
            <li>No vuelvas a cubrirlo con film después del primer lavado</li>
          </ul>
        </div>

        <div>
          <h3 class="aftercare__subtitle">Primeras 2-3 semanas</h3>
          <ul class="aftercare__list">
            <li>Lava 2-3 veces al día con jabón neutro y aplica crema</li>
            <li>No rasques ni arranques las costras — se caen solas</li>
            <li>Evita el sol directo, piscinas, mar y saunas</li>
            <li>Usa ropa holgada sobre la zona tatuada</li>
            <li>No hagas ejercicio intenso los primeros 3-5 días</li>
          </ul>
        </div>

        <div>
          <h3 class="aftercare__subtitle">A largo plazo</h3>
          <ul class="aftercare__list">
            <li>Usa protector solar SPF50+ en el tatuaje cuando te expongas al sol</li>
            <li>Hidrata la piel regularmente para mantener los colores vivos</li>
            <li>Si notas algo raro durante la curación, escríbenos — estamos para ayudarte</li>
          </ul>
        </div>

        <div>
          <h3 class="aftercare__subtitle">Qué NO hacer</h3>
          <ul class="aftercare__list aftercare__list--dont">
            <li>No uses alcohol, agua oxigenada ni Betadine sobre el tatuaje</li>
            <li>No lo expongas al sol directo durante al menos 4 semanas</li>
            <li>No te bañes en piscina ni mar hasta que esté completamente curado</li>
            <li>No uses cremas con perfume ni vaselina</li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Final CTA -->
    <div class="contact-cta reveal">
      <p class="contact-cta__subtitle">¿Alguna duda?</p>
      <p class="contact-cta__title">Pregúntanos lo que sea</p>
      <a href="https://wa.me/34611411420?text=Hola,%20tengo%20una%20duda%20sobre%20el%20proceso"
         target="_blank" rel="noopener"
         class="btn-ghost--accent btn-ghost">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        Escribir por WhatsApp
      </a>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  /* ── Main layout ──────────────────────────────────── */
  .contacto-main {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 24px 80px;
  }

  /* ── Contact grid (info + map) ────────────────────── */
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    margin-bottom: 80px;
    align-items: start;
  }

  /* ── Contact info rows ────────────────────────────── */
  .contact-info {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .contact-info__row {
    padding: 20px 0;
  }

  .contact-info__row--border {
    border-bottom: 1px solid var(--color-border);
  }

  .contact-info__label {
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 500;
    color: var(--color-accent);
    margin: 0 0 6px;
    letter-spacing: -0.01em;
  }

  .contact-info__value {
    font-family: var(--font-serif);
    font-size: 17px;
    color: var(--color-text-primary);
    line-height: 1.5;
    margin: 0;
  }

  .contact-info__link {
    font-family: var(--font-serif);
    font-size: 17px;
    color: var(--color-text-primary);
    text-decoration: none;
  }

  .contact-info__link:hover {
    color: var(--color-accent);
  }

  .contact-info__muted {
    color: var(--color-text-secondary);
  }

  .contact-info__wa-btn {
    margin-top: 8px;
  }

  /* ── Badges row ───────────────────────────────────── */
  .contact-badges {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    padding-top: 8px;
  }

  /* ── Map ───────────────────────────────────────────── */
  .contact-map {
    overflow: hidden;
    height: 400px;
  }

  .contact-map__caption {
    font-family: var(--font-serif);
    font-size: 14px;
    color: var(--color-text-secondary);
    margin-top: 8px;
  }

  .contact-map__link {
    color: var(--color-accent);
    text-decoration: none;
  }

  .contact-map__link:hover {
    text-decoration: underline;
  }

  /* ── Process section ──────────────────────────────── */
  .contact-section {
    margin-bottom: 80px;
  }

  .contact-section__heading {
    margin-bottom: 40px;
  }

  .process-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 32px;
  }

  .process-card__number {
    font-family: var(--font-wordmark);
    font-size: 48px;
    color: var(--color-accent);
    line-height: 1;
    margin: 0 0 12px;
    letter-spacing: 0.02em;
  }

  .process-card__title {
    font-family: var(--font-wordmark);
    font-size: 24px;
    color: var(--color-text-primary);
    letter-spacing: 0.03em;
    margin: 0 0 12px;
  }

  .process-card__desc {
    font-family: var(--font-serif);
    font-size: 15px;
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin: 0;
  }

  /* ── Aftercare section ────────────────────────────── */
  .aftercare {
    background: var(--color-accent-bg);
    border: 1px solid rgba(155, 77, 202, 0.2);
    border-radius: var(--radius-card);
    padding: 48px;
    margin-bottom: 64px;
  }

  .aftercare__title {
    font-family: var(--font-wordmark);
    font-size: clamp(28px, 4vw, 40px);
    letter-spacing: 0.03em;
    color: var(--color-accent);
    margin: 0 0 32px;
  }

  .aftercare-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
  }

  .aftercare__subtitle {
    font-family: var(--font-wordmark);
    font-size: 22px;
    letter-spacing: 0.03em;
    color: var(--color-text-primary);
    margin: 0 0 16px;
  }

  .aftercare__list {
    font-family: var(--font-serif);
    font-size: 15px;
    color: var(--color-text-primary);
    line-height: 1.8;
    padding-left: 20px;
    margin: 0;
    list-style-type: '→ ';
  }

  .aftercare__list--dont {
    list-style-type: '✕ ';
  }

  /* ── Final CTA ────────────────────────────────────── */
  .contact-cta {
    text-align: center;
  }

  .contact-cta__subtitle {
    font-family: var(--font-serif);
    font-size: 17px;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin: 0 0 8px;
  }

  .contact-cta__title {
    font-family: var(--font-wordmark);
    font-size: 28px;
    letter-spacing: 0.03em;
    color: var(--color-text-primary);
    margin: 0 0 20px;
  }

  /* ── Responsive ───────────────────────────────────── */
  @media (max-width: 640px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .contact-map {
      height: 280px;
    }
    .process-grid {
      grid-template-columns: 1fr;
    }
    .aftercare-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .aftercare {
      padding: 32px 24px;
    }
  }
</style>
