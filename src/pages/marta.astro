---
import Layout from '../layouts/Layout.astro';
import Nav    from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Marta — Coyote Tattoo" description="Marta, tatuadora y fundadora de Coyote Tattoo en Alcobendas. Más de 25 años de experiencia en tatuajes, micropigmentación y piercings.">
  <Nav />

  <main class="marta-page">

    <!-- Page header -->
    <div class="page-header reveal">
      <p class="page-header__label">La artista</p>
      <h1 class="page-header__title">Marta</h1>
      <div class="page-header__accent"></div>
    </div>

    <!-- Hero photo -->
    <div class="marta-hero reveal">
      <div class="img-frame marta-hero__portrait">
        <img src="/images/marta-working.webp"
             alt="Marta — Tatuadora en Coyote Tattoo"
             class="marta-hero__img" />
      </div>
      <div class="img-frame marta-hero__square">
        <img src="/images/marta-tattooing.webp"
             alt="Marta tatuando en el estudio"
             class="marta-hero__img" />
      </div>
    </div>

    <!-- Bio section -->
    <div class="marta-content reveal">
      <!-- Left: Story -->
      <div>
        <h2 class="marta-heading">Quién es Marta</h2>
        <p class="marta-body">
          En febrero del 98, Marta abrió un estudio de tatuajes en Alcobendas. En esa época
          tatuarse no era normal — ni estaba de moda ni era fácil encontrar un sitio de confianza.
          27 años después, sigue en el mismo local.
        </p>
        <p class="marta-body">
          No tiene un estilo fijo. Hace lo que le pidas — un nombre, un retrato, algo
          abstracto, algo pequeño, algo que ocupe medio brazo. Lo que sí tiene es criterio:
          si algo no va a quedar bien, te lo dice.
        </p>
        <p class="marta-body marta-body--muted">
          No trabaja con plantillas. Le cuentas lo que quieres, lo habláis,
          y sale algo que no existía antes.
        </p>
      </div>

      <!-- Right: Style & qualifications -->
      <div>
        <h2 class="marta-heading">Estilo y especialidades</h2>

        <div class="marta-services">
          {[
            { label: 'Tatuaje a medida', desc: 'Le cuentas tu idea y te diseña algo. Fine line, blackwork, color, realismo, lettering — lo que necesites.' },
            { label: 'Micropigmentación', desc: 'Cejas, delineado de ojos y labios. Queda natural.' },
            { label: 'Piercings', desc: 'Material de primera, aguja nueva siempre. Rápido y limpio.' },
            { label: 'Cover-ups', desc: '¿Tienes un tatuaje viejo que ya no te gusta? Marta le da una segunda vida.' },
          ].map(item => (
            <div class="marta-service-item">
              <p class="marta-service-item__label">{item.label}</p>
              <p class="marta-service-item__desc">{item.desc}</p>
            </div>
          ))}
        </div>

        <!-- Stats -->
        <div class="marta-stats" id="marta-stats">
          <div class="marta-stat">
            <p class="marta-stat__number" data-target="27">0</p>
            <p class="marta-stat__label">años</p>
          </div>
          <div class="marta-stat">
            <p class="marta-stat__number" data-target="4.6" data-suffix="★" data-decimal="true">0</p>
            <p class="marta-stat__label">en Google</p>
          </div>
          <div class="marta-stat">
            <p class="marta-stat__number" data-target="148">0</p>
            <p class="marta-stat__label">reseñas</p>
          </div>
        </div>
      </div>

      <!-- Badges -->
      <div class="marta-badges">
        <span class="badge">🏳️‍🌈 LGBTQ+ friendly</span>
        <span class="badge">♀ Propietaria mujer</span>
      </div>
    </div>

    <!-- Qualifications -->
    <div class="marta-quals card reveal">
      <h2 class="marta-quals__title">Por qué fiarte</h2>
      <div class="quals-grid">
        {[
          { icon: '✓', title: '27 años de experiencia', text: 'Tatuando desde 1998. Ha visto pasar todas las modas y sigue aquí.' },
          { icon: '✓', title: 'Todo estéril, siempre', text: 'Aguja nueva para cada persona. Material esterilizado. Tintas homologadas. Sin excepciones.' },
          { icon: '✓', title: 'Tintas veganas', text: 'Hipoalergénicas y de marcas reconocidas. Aptas para pieles sensibles.' },
          { icon: '✓', title: 'Te acompaña después', text: 'Después del tatuaje Marta te explica el cuidado y está disponible si tienes dudas durante la curación.' },
        ].map(q => (
          <div class="marta-qual-item">
            <span class="marta-qual-item__icon">{q.icon}</span>
            <div>
              <p class="marta-qual-item__title">{q.title}</p>
              <p class="marta-qual-item__text">{q.text}</p>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- CTA -->
    <div class="marta-cta reveal">
      <p class="marta-cta__title">Reserva con Marta</p>
      <a href="https://wa.me/34611411420?text=%C2%A1Hola!%20Vengo%20desde%20vuestra%20web%20y%20quiero%20info%20para%20un%20tatuaje%20%F0%9F%99%8C%20Zona%3A%20__%20%C2%B7%20%C2%BFReferencia%3F%20S%C3%AD%2FNo.%20%C2%A1Gracias!"
         target="_blank" rel="noopener"
         class="btn-ghost--accent btn-ghost"
         data-wa-src="marta">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        Escribir por WhatsApp
      </a>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  /* ── Page layout ─────────────────────────────────── */
  .marta-page {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 24px 80px;
  }

  /* ── Hero grid ───────────────────────────────────── */
  .marta-hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-bottom: 64px;
    align-items: start;
  }

  .marta-hero__portrait {
    aspect-ratio: 3 / 4;
    overflow: hidden;
  }

  .marta-hero__square {
    aspect-ratio: 1 / 1;
    overflow: hidden;
  }

  .marta-hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .marta-hero__portrait .marta-hero__img {
    object-position: top;
  }

  /* ── Bio content grid ────────────────────────────── */
  .marta-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    margin-bottom: 80px;
    align-items: start;
  }

  /* ── Headings ────────────────────────────────────── */
  .marta-heading {
    font-family: var(--font-wordmark);
    font-size: 32px;
    font-weight: 400;
    letter-spacing: 0.03em;
    color: var(--color-text-primary);
    margin: 0 0 20px;
  }

  /* ── Body text ───────────────────────────────────── */
  .marta-body {
    font-family: var(--font-serif);
    font-size: 17px;
    color: var(--color-text-primary);
    line-height: 1.7;
    letter-spacing: -0.14px;
    margin: 0 0 16px;
  }

  .marta-body--muted {
    color: var(--color-text-secondary);
    margin: 0;
  }

  /* ── Service items ───────────────────────────────── */
  .marta-services {
    margin-bottom: 28px;
  }

  .marta-service-item {
    padding: 16px 0;
    border-bottom: 1px solid var(--color-border);
  }

  .marta-service-item__label {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 500;
    color: var(--color-text-primary);
    margin: 0 0 6px;
    letter-spacing: -0.01em;
  }

  .marta-service-item__desc {
    font-family: var(--font-serif);
    font-size: 15px;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin: 0;
  }

  /* ── Stats box ───────────────────────────────────── */
  .marta-stats {
    display: flex;
    gap: 32px;
    padding: 24px;
    background: var(--color-accent-bg);
    border: 1px solid rgba(155, 77, 202, 0.2);
    border-radius: var(--radius-card);
  }

  .marta-stat__number {
    font-family: var(--font-wordmark);
    font-size: 40px;
    color: var(--color-accent);
    line-height: 1;
    margin: 0;
    letter-spacing: 0.02em;
  }

  .marta-stat__label {
    font-family: var(--font-sans);
    font-size: 12px;
    color: var(--color-text-secondary);
    margin: 4px 0 0;
  }

  /* ── Badges ──────────────────────────────────────── */
  .marta-badges {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 20px;
  }

  /* ── Qualifications card ─────────────────────────── */
  .marta-quals {
    margin-bottom: 64px;
    padding: 40px;
  }

  .marta-quals__title {
    font-family: var(--font-wordmark);
    font-size: 28px;
    font-weight: 400;
    letter-spacing: 0.03em;
    color: var(--color-text-primary);
    margin: 0 0 24px;
  }

  .quals-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }

  .marta-qual-item {
    display: flex;
    gap: 12px;
    align-items: start;
  }

  .marta-qual-item__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--color-accent);
    color: #fff;
    font-size: 14px;
    font-weight: 700;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .marta-qual-item__title {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 500;
    color: var(--color-text-primary);
    margin: 0 0 4px;
  }

  .marta-qual-item__text {
    font-family: var(--font-serif);
    font-size: 15px;
    color: var(--color-text-secondary);
    line-height: 1.5;
    margin: 0;
  }

  /* ── CTA ─────────────────────────────────────────── */
  .marta-cta {
    text-align: center;
  }

  .marta-cta__title {
    font-family: var(--font-wordmark);
    font-size: 32px;
    font-weight: 400;
    letter-spacing: 0.03em;
    color: var(--color-text-primary);
    margin: 0 0 20px;
  }

  /* ── Responsive ──────────────────────────────────── */
  @media (max-width: 640px) {
    .marta-hero {
      grid-template-columns: 1fr;
    }

    .marta-content {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .quals-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<!-- Counter animation for stats -->
<script>
  document.addEventListener('astro:page-load', () => {
    const statsSection = document.getElementById('marta-stats');
    if (!statsSection) return;

    let hasAnimated = false;

    function easeOutQuad(t: number): number {
      return t * (2 - t);
    }

    function animateCounter(el: HTMLElement) {
      const target = parseFloat(el.dataset.target || '0');
      const suffix = el.dataset.suffix || '';
      const isDecimal = el.dataset.decimal === 'true';
      const duration = 1500;
      const startTime = performance.now();

      function update(currentTime: number) {
        const elapsed = currentTime - startTime;
        const progress = Math.min(elapsed / duration, 1);
        const easedProgress = easeOutQuad(progress);
        const currentValue = easedProgress * target;

        if (isDecimal) {
          el.textContent = currentValue.toFixed(1).replace('.', ',') + suffix;
        } else {
          el.textContent = Math.floor(currentValue).toString() + suffix;
        }

        if (progress < 1) {
          requestAnimationFrame(update);
        } else {
          if (isDecimal) {
            el.textContent = target.toFixed(1).replace('.', ',') + suffix;
          } else {
            el.textContent = target.toString() + suffix;
          }
        }
      }

      requestAnimationFrame(update);
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting && !hasAnimated) {
            hasAnimated = true;
            const counters = statsSection.querySelectorAll<HTMLElement>('.marta-stat__number');
            counters.forEach((counter) => animateCounter(counter));
            observer.disconnect();
          }
        });
      },
      { threshold: 0.5 }
    );

    observer.observe(statsSection);
  });
</script>
