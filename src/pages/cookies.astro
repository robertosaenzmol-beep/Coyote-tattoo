---
import Layout from '../layouts/Layout.astro';
import Nav    from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Política de Cookies — Coyote Tattoo">
  <Nav />

  <main class="legal-page">
    <h1 class="legal-page__title">Política de Cookies</h1>

    <div class="legal-content">
      <h2>1. ¿Qué son las cookies?</h2>
      <p>Las cookies son pequeños archivos de texto que se almacenan en tu dispositivo cuando visitas un sitio web. Permiten que el sitio recuerde información sobre tu visita, como tus preferencias, para facilitar tu próxima visita.</p>

      <h2>2. ¿Qué cookies utiliza este sitio web?</h2>
      <p>Este sitio web utiliza cookies de terceros. Solo se activan las cookies analíticas si aceptas el banner de consentimiento.</p>

      <table class="cookie-table">
        <thead>
          <tr>
            <th>Servicio</th>
            <th>Tipo</th>
            <th>Finalidad</th>
            <th>Duración</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Google Analytics (GA4)</td>
            <td>Analítica</td>
            <td>Medir visitas y uso de la web de forma agregada. No se recogen datos personales.</td>
            <td>Hasta 2 años</td>
          </tr>
          <tr>
            <td>Google Maps</td>
            <td>Funcional (terceros)</td>
            <td>Mostrar el mapa de ubicación del estudio</td>
            <td>Variable</td>
          </tr>
          <tr>
            <td>Google Fonts</td>
            <td>Funcional (terceros)</td>
            <td>Carga de tipografías (Bebas Neue, Lora, Inter)</td>
            <td>Variable</td>
          </tr>
        </tbody>
      </table>

      <h2>3. Base legal</h2>
      <p>Las cookies analíticas se instalan únicamente con tu consentimiento expreso (art. 22.2 LSSI y art. 6.1.a RGPD). Las cookies funcionales de terceros (Google Maps, Google Fonts) se basan en interés legítimo para el correcto funcionamiento de la web.</p>

      <h2>4. Gestionar tu consentimiento</h2>
      <p>Puedes cambiar o retirar tu consentimiento en cualquier momento pulsando el botón de abajo. También puedes configurar tu navegador para rechazar cookies.</p>

      <div class="cookie-manage">
        <p class="cookie-manage__status" id="consent-status"></p>
        <button id="cookie-revoke" class="btn-ghost">Cambiar preferencias de cookies</button>
      </div>

      <h2>5. ¿Cómo desactivar las cookies desde el navegador?</h2>
      <p>Puedes configurar tu navegador para rechazar todas las cookies o para que te avise cuando se envíe una cookie. Ten en cuenta que al desactivar cookies de terceros, algunos elementos del sitio (como el mapa de Google Maps) podrían no funcionar correctamente.</p>
      <ul>
        <li><strong>Chrome:</strong> Configuración → Privacidad y seguridad → Cookies</li>
        <li><strong>Firefox:</strong> Opciones → Privacidad y seguridad → Cookies</li>
        <li><strong>Safari:</strong> Preferencias → Privacidad → Cookies</li>
        <li><strong>Edge:</strong> Configuración → Privacidad → Cookies</li>
      </ul>

      <h2>6. Más información</h2>

      <p>Si tienes dudas sobre esta política de cookies, puedes contactarnos en:</p>
      <ul>
        <li><strong>Email:</strong> [EMAIL DE CONTACTO]</li>
        <li><strong>Teléfono:</strong> 611 41 14 20</li>
        <li><strong>Dirección:</strong> Calle Real Vieja, 32, 28100 Alcobendas, Madrid</li>
      </ul>

      <p class="legal-content__date">Última actualización: 15 de septiembre de 2026</p>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  .legal-page {
    max-width: 800px;
    margin: 0 auto;
    padding: 100px 24px 80px;
  }
  .legal-page__title {
    font-family: var(--font-wordmark);
    font-size: clamp(32px, 8vw, 48px);
    letter-spacing: 0.04em;
    color: var(--color-text-primary);
    margin: 0 0 32px;
  }
  .legal-content {
    font-family: var(--font-serif);
    font-size: 16px;
    color: var(--color-text-primary);
    line-height: 1.8;
  }
  .legal-content h2 {
    font-family: var(--font-wordmark);
    font-size: 24px;
    letter-spacing: 0.03em;
    color: var(--color-text-primary);
    margin: 32px 0 12px;
  }
  .legal-content p { margin: 0 0 16px; }
  .legal-content ul { margin: 0 0 16px; padding-left: 24px; }
  .legal-content li { margin-bottom: 6px; }
  .legal-content strong { color: var(--color-accent); }
  .legal-content__date {
    color: var(--color-text-secondary);
    margin-top: 40px;
    font-size: 14px;
  }

  .cookie-table {
    width: 100%;
    border-collapse: collapse;
    margin: 16px 0 24px;
  }
  .cookie-table th {
    padding: 8px 12px;
    font-family: var(--font-sans);
    font-size: 13px;
    text-align: left;
    border-bottom: 2px solid var(--color-border);
    color: var(--color-text-primary);
  }
  .cookie-table td {
    padding: 8px 12px;
    border-bottom: 1px solid var(--color-border);
  }

  .cookie-manage {
    margin: 20px 0 32px;
    padding: 20px 24px;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
  }
  .cookie-manage__status {
    font-family: var(--font-sans);
    font-size: 14px;
    color: var(--color-text-secondary);
    margin: 0 0 16px;
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const status = document.getElementById('consent-status');
    const revokeBtn = document.getElementById('cookie-revoke');
    if (!status || !revokeBtn) return;

    function updateStatus() {
      const consent = localStorage.getItem('cookie-consent');
      if (consent === 'accepted') {
        status!.textContent = 'Estado actual: Has aceptado las cookies analíticas.';
      } else if (consent === 'rejected') {
        status!.textContent = 'Estado actual: Has rechazado las cookies analíticas.';
      } else {
        status!.textContent = 'Estado actual: No has elegido todavía.';
      }
    }

    updateStatus();

    revokeBtn.addEventListener('click', () => {
      localStorage.removeItem('cookie-consent');
      // Delete GA cookies
      document.cookie.split(';').forEach(c => {
        const name = c.trim().split('=')[0];
        if (name.startsWith('_ga')) {
          document.cookie = name + '=;expires=Thu, 01 Jan 1970 00:00:00 GMT;path=/;domain=.' + location.hostname;
          document.cookie = name + '=;expires=Thu, 01 Jan 1970 00:00:00 GMT;path=/';
        }
      });
      updateStatus();
      // Show the consent banner again
      const banner = document.getElementById('cookie-banner');
      if (banner) {
        banner.classList.add('is-visible');
        banner.setAttribute('aria-hidden', 'false');
      }
    });
  });
</script>
