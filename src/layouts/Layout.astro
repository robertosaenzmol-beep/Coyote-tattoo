---
import { ViewTransitions } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}
const {
  title = 'Coyote Tattoo — Estudio de tatuajes en Alcobendas, Madrid',
  description = 'Estudio de tatuajes en Alcobendas, Madrid. Diseños a medida. 4,6★ con 148 reseñas en Google.',
  ogImage = '/images/logo.webp',
} = Astro.props;

const siteUrl = 'https://coyote-tattoo.vercel.app';
const canonicalURL = new URL(Astro.url.pathname, siteUrl).href;
const ogImageURL = new URL(ogImage, siteUrl).href;
const isHomepage = Astro.url.pathname === '/' || Astro.url.pathname === '';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0a0a" />
    <title>{title}</title>
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="Coyote Tattoo" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- GA4 — loaded dynamically after cookie consent -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
    </script>

    <!-- LocalBusiness Schema (homepage only) -->
    {isHomepage && (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "TattooParlor",
        "name": "Coyote Tattoo",
        "image": ogImageURL,
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Calle Real Vieja, 32",
          "addressLocality": "Alcobendas",
          "addressRegion": "Madrid",
          "postalCode": "28100",
          "addressCountry": "ES"
        },
        "geo": {
          "@type": "GeoCoordinates",
          "latitude": 40.5424,
          "longitude": -3.6391
        },
        "telephone": "+34611411420",
        "url": siteUrl,
        "hasMap": "https://maps.app.goo.gl/1BLkX6jwvPRLCYDfA",
        "sameAs": [
          "https://www.instagram.com/coyotetattoo/",
          "https://maps.app.goo.gl/1BLkX6jwvPRLCYDfA"
        ],
        "aggregateRating": {
          "@type": "AggregateRating",
          "ratingValue": "4.6",
          "reviewCount": "148",
          "bestRating": "5"
        },
        "openingHoursSpecification": [
          { "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"], "opens": "11:00", "closes": "14:00" },
          { "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"], "opens": "16:00", "closes": "20:30" },
          { "dayOfWeek": "Saturday", "opens": "11:00", "closes": "14:00" }
        ],
        "priceRange": "$$"
      })} />
    )}

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Lora:ital,wght@0,400;0,500;0,600;1,400&family=Inter:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/webp" href="/images/logo.webp" />
