  </head>

  <body>
    <!-- Skip link -->
    <a href="#main-content" class="skip-link">Ir al contenido</a>

    <slot />

    <!-- Custom cursor -->
    <div class="cursor-dot" aria-hidden="true"></div>
    <div class="cursor-ring" aria-hidden="true"></div>

    <!-- Floating WhatsApp button (desktop) -->
    <a
      href="https://wa.me/34611411420?text=%C2%A1Hola!%20Vengo%20desde%20vuestra%20web%20y%20quiero%20info%20para%20un%20tatuaje%20%F0%9F%99%8C%20Zona%3A%20__%20%C2%B7%20%C2%BFReferencia%3F%20S%C3%AD%2FNo.%20%C2%A1Gracias!"
      target="_blank"
      rel="noopener"
      class="wa-float"
      aria-label="Contactar por WhatsApp"
      data-wa-src="floating"
    >
      <svg width="24" height="24" viewBox="0 0 24 24" fill="#fff">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
      </svg>
    </a>

    <!-- WhatsApp button (mobile) -->
    <a
      href="https://wa.me/34611411420?text=%C2%A1Hola!%20Vengo%20desde%20vuestra%20web%20y%20quiero%20info%20para%20un%20tatuaje%20%F0%9F%99%8C%20Zona%3A%20__%20%C2%B7%20%C2%BFReferencia%3F%20S%C3%AD%2FNo.%20%C2%A1Gracias!"
      target="_blank"
      rel="noopener"
      class="wa-mobile"
      aria-label="Contactar por WhatsApp"
      data-wa-src="sticky-bar"
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="#fff">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
      </svg>
    </a>

    <!-- Cookie consent banner -->
    <div id="cookie-banner" class="cookie-banner" role="dialog" aria-label="Consentimiento de cookies" aria-hidden="true">
      <div class="cookie-banner__inner">
        <p class="cookie-banner__text">
          Usamos cookies analíticas (Google Analytics) para entender cómo se usa la web y mejorarla.
          No se recogen datos personales. Puedes leer más en nuestra
          <a href="/cookies" class="cookie-banner__link">política de cookies</a>.
        </p>
        <div class="cookie-banner__actions">
          <button id="cookie-reject" class="cookie-banner__btn cookie-banner__btn--reject">Rechazar</button>
          <button id="cookie-accept" class="cookie-banner__btn cookie-banner__btn--accept">Aceptar</button>
        </div>
      </div>
    </div>
  </body>
</html>

<!-- Centralized reveal-on-scroll observer -->
<script>
  function initReveals() {
    const obs = new IntersectionObserver(
      (entries) => entries.forEach(e => {
        if (!e.isIntersecting) return;
        const el = e.target;

        // Stagger container: animate children sequentially
        if (el.hasAttribute('data-stagger')) {
          el.querySelectorAll('.reveal, .reveal-left, .reveal-scale').forEach((child, i) => {
            (child as HTMLElement).style.setProperty('--i', String(i));
            setTimeout(() => child.classList.add('visible'), i * 100);
          });
        }

        el.classList.add('visible');
      }),
      { threshold: 0.08, rootMargin: '0px 0px -32px 0px' }
    );

    document.querySelectorAll('.reveal, .reveal-left, .reveal-scale, [data-stagger]')
      .forEach(el => obs.observe(el));
  }

  // Works with Astro View Transitions
  document.addEventListener('astro:page-load', initReveals);

  // ── Custom cursor ──────────────────────────────────
  function initCursor() {
    const dot = document.querySelector('.cursor-dot') as HTMLElement | null;
    const ring = document.querySelector('.cursor-ring') as HTMLElement | null;
    if (!dot || !ring) return;

    // Only on non-touch devices
    if (!matchMedia('(hover: hover) and (pointer: fine)').matches) return;

    let mouseX = -100, mouseY = -100;
    let ringX = -100, ringY = -100;
    let visible = false;

    document.addEventListener('mousemove', (e) => {
      mouseX = e.clientX;
      mouseY = e.clientY;
      dot.style.left = mouseX + 'px';
      dot.style.top = mouseY + 'px';
      if (!visible) {
        visible = true;
        dot.classList.add('is-visible');
        ring.classList.add('is-visible');
        ringX = mouseX;
        ringY = mouseY;
      }
    });

    document.addEventListener('mousedown', () => {
      dot.classList.add('is-pressing');
      ring.classList.add('is-pressing');
    });
    document.addEventListener('mouseup', () => {
      dot.classList.remove('is-pressing');
      ring.classList.remove('is-pressing');
    });

    document.addEventListener('mouseleave', () => {
      visible = false;
      dot.classList.remove('is-visible');
      ring.classList.remove('is-visible');
    });

    // Ring follows with lag
    function animateRing() {
      ringX += (mouseX - ringX) * 0.15;
      ringY += (mouseY - ringY) * 0.15;
      ring.style.left = ringX + 'px';
      ring.style.top = ringY + 'px';
      requestAnimationFrame(animateRing);
    }
    requestAnimationFrame(animateRing);

    // Expand on interactive elements
    function bindHovers() {
      document.querySelectorAll('a, button, [role="button"], .tattoo-card, .gallery-item, .explore-card, input, textarea, select').forEach(el => {
        el.addEventListener('mouseenter', () => {
          dot.classList.add('is-hover');
          ring.classList.add('is-hover');
        });
        el.addEventListener('mouseleave', () => {
          dot.classList.remove('is-hover');
          ring.classList.remove('is-hover');
        });
      });
    }
    bindHovers();
  }

  document.addEventListener('astro:page-load', initCursor);

  // ── Cookie consent + GA4 ──────────────────────────
  function loadGA4() {
    if (document.getElementById('ga4-script')) return;
    const s = document.createElement('script');
    s.id = 'ga4-script';
    s.async = true;
    s.src = 'https://www.googletagmanager.com/gtag/js?id=G-D5RKLEFSG0';
    document.head.appendChild(s);
    gtag('js', new Date());
    gtag('config', 'G-D5RKLEFSG0');
  }

  function initTracking() {
    if (typeof gtag !== 'function') return;

    document.querySelectorAll('[data-wa-src]').forEach(el => {
      el.addEventListener('click', () => {
        gtag('event', 'whatsapp_click', {
          event_category: 'CTA',
          event_label: (el as HTMLElement).dataset.waSrc,
        });
      });
    });

    document.querySelectorAll('[data-tel-src]').forEach(el => {
      el.addEventListener('click', () => {
        gtag('event', 'phone_click', {
          event_category: 'CTA',
          event_label: (el as HTMLElement).dataset.telSrc,
        });
      });
    });
  }

  function initCookieConsent() {
    const banner = document.getElementById('cookie-banner');
    const acceptBtn = document.getElementById('cookie-accept');
    const rejectBtn = document.getElementById('cookie-reject');
    if (!banner || !acceptBtn || !rejectBtn) return;

    const consent = localStorage.getItem('cookie-consent');

    if (consent === 'accepted') {
      loadGA4();
      initTracking();
      return;
    }

    if (consent === 'rejected') return;

    // No choice yet — show banner
    banner.classList.add('is-visible');
    banner.setAttribute('aria-hidden', 'false');

    acceptBtn.addEventListener('click', () => {
      localStorage.setItem('cookie-consent', 'accepted');
      banner.classList.remove('is-visible');
      banner.setAttribute('aria-hidden', 'true');
      loadGA4();
      initTracking();
    });

    rejectBtn.addEventListener('click', () => {
      localStorage.setItem('cookie-consent', 'rejected');
      banner.classList.remove('is-visible');
      banner.setAttribute('aria-hidden', 'true');
    });
  }

  document.addEventListener('astro:page-load', () => {
    initCookieConsent();
    // If consent was already given on a previous page, bind event tracking
    if (localStorage.getItem('cookie-consent') === 'accepted') {
      initTracking();
    }
  });
</script>

<style is:global>
  /* ── Design tokens ─────────────────────────────────── */
  :root {
    /* Surfaces */
    --color-bg:           #0a0a0a;
    --color-bg-elevated:  #111111;
    --color-bg-card:      #161616;
    --color-bg-muted:     #1a1a1a;

    /* Borders */
    --color-border:        #222222;
    --color-border-subtle: #1a1a1a;

    /* Text */
    --color-text-primary:   #f0f0f0;
    --color-text-secondary: #9b9b9b;
    --color-text-muted:     #888888;

    /* Accent */
    --color-accent:       #9B4DCA;
    --color-accent-light: #b06edf;
    --color-accent-dark:  #7B3BA8;
    --color-accent-glow:  rgba(155, 77, 202, 0.25);
    --color-accent-bg:    rgba(155, 77, 202, 0.1);

    /* Typography */
    --font-wordmark:     'Bebas Neue', Impact, sans-serif;
    --font-serif:        'Lora', Georgia, serif;
    --font-sans:         'Inter', system-ui, sans-serif;

    /* Radii */
    --radius-card:       10px;
    --radius-pill:       48px;
  }

  /* ── Base ──────────────────────────────────────────── */
  * { margin: 0; padding: 0; box-sizing: border-box; }

  html {
    scroll-behavior: smooth;
    scroll-padding-top: 80px;
    overflow-x: hidden;
  }

  body {
    font-family: var(--font-serif);
    font-size: 16px;
    line-height: 1.3;
    letter-spacing: -0.14px;
    color: var(--color-text-primary);
    background: var(--color-bg);
    overflow-x: hidden;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  /* Page entrance */
  body { animation: page-enter 0.5s ease; }
  @keyframes page-enter {
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  /* ── Skip link ─────────────────────────────────────── */
  .skip-link {
    position: absolute;
    top: -100%;
    left: 16px;
    z-index: 999;
    padding: 8px 16px;
    background: var(--color-accent);
    color: #fff;
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 500;
    border-radius: var(--radius-pill);
    text-decoration: none;
  }
  .skip-link:focus {
    top: 16px;
  }

  /* ── Focus visible ─────────────────────────────────── */
  :focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  /* ── Section label (purple small caps) ─────────────── */
  .section-label {
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--color-accent);
    margin-bottom: 12px;
  }

  /* ── Section title (Bebas headline) ────────────────── */
  .section-title {
    font-family: var(--font-wordmark);
    font-size: clamp(32px, 5vw, 52px);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: 0.03em;
    color: var(--color-text-primary);
    margin: 0;
  }

  /* ── Page header ───────────────────────────────────── */
  .page-header {
    padding: 100px 0 48px;
  }
  .page-header__label {
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--color-accent);
    margin-bottom: 12px;
  }
  .page-header__title {
    font-family: var(--font-wordmark);
    font-size: clamp(40px, 7vw, 72px);
    font-weight: 400;
    line-height: 1;
    letter-spacing: 0.04em;
    color: var(--color-text-primary);
    margin: 0 0 16px;
  }
  .page-header__desc {
    font-family: var(--font-serif);
    font-size: 18px;
    color: var(--color-text-secondary);
    line-height: 1.6;
    max-width: 500px;
  }
  .page-header__accent {
    width: 48px;
    height: 3px;
    background: var(--color-accent);
    margin-top: 24px;
    border-radius: 2px;
  }

  /* ── Hairline image border ─────────────────────────── */
  .img-frame {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    overflow: hidden;
    display: block;
  }

  /* ── Card ───────────────────────────────────────────── */
  .card {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    padding: 28px;
  }

  /* ── Ghost button ──────────────────────────────────── */
  .btn-ghost {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    padding: 12px 22px;
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 500;
    line-height: 1;
    min-height: 44px;
    letter-spacing: -0.01em;
    color: var(--color-text-primary);
    background: transparent;
    text-decoration: none;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease,
                transform 0.2s ease, box-shadow 0.3s ease;
    white-space: nowrap;
  }
  .btn-ghost:hover {
    background: var(--color-text-primary);
    color: var(--color-bg);
    border-color: var(--color-text-primary);
    transform: scale(1.03);
  }
  .btn-ghost:active {
    transform: scale(0.98);
  }

  /* Ghost button - accent variant */
  .btn-ghost--accent {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
  .btn-ghost--accent:hover {
    background: var(--color-accent);
    color: #fff;
    border-color: var(--color-accent);
    box-shadow: 0 0 20px var(--color-accent-glow);
  }

  /* ── WhatsApp CTA button ───────────────────────────── */
  .btn-wa {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 14px 28px;
    border-radius: var(--radius-pill);
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    background: var(--color-accent);
    color: #fff;
    border: 1px solid var(--color-accent);
    cursor: pointer;
    transition: transform 0.2s ease, box-shadow 0.3s ease, background 0.2s ease;
  }
  .btn-wa:hover {
    background: var(--color-accent-dark);
    transform: scale(1.03);
    box-shadow: 0 0 24px var(--color-accent-glow);
  }
  .btn-wa:active {
    transform: scale(0.98);
  }

  /* ── Outline button (for dark surfaces) ────────────── */
  .btn-outline {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 14px 28px;
    border-radius: var(--radius-pill);
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    background: transparent;
    color: var(--color-text-primary);
    border: 1px solid var(--color-text-primary);
    cursor: pointer;
    transition: transform 0.2s ease, background 0.2s ease, color 0.2s ease;
  }
  .btn-outline:hover {
    background: var(--color-text-primary);
    color: var(--color-bg);
    transform: scale(1.03);
  }
  .btn-outline:active {
    transform: scale(0.98);
  }

  /* ── Tag label ─────────────────────────────────────── */
  .tag {
    font-family: var(--font-serif);
    font-size: 16px;
    color: var(--color-text-secondary);
    letter-spacing: -0.14px;
    line-height: 1.3;
  }

  /* ── Section divider (gradient hairline) ────────────── */
  .hairline {
    border: none;
    height: 1px;
    background: linear-gradient(to right, transparent, var(--color-border), transparent);
    margin: 0;
  }

  /* ── Badge ─────────────────────────────────────────── */
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 500;
