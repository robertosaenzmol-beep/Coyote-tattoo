---
---

<!-- Smooth visual bridge: thin strip of gallery images -->
<div style="
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 1px; background: #000;
  border-top: 1px solid #000;
  border-bottom: 1px solid #000;
  height: 120px; overflow: hidden;
" aria-hidden="true">
  {[1,3,5,6,7].map(n => (
    <div style="overflow: hidden;">
      <img
        src={`/images/gallery/tattoo-0${n}.webp`}
        alt=""
        style="width:100%; height:100%; object-fit:cover; display:block; filter:brightness(0.7);"
        loading="lazy"
      />
    </div>
  ))}
</div>

<!-- Contact section -->
<section id="contacto" style="
  padding: 64px 24px 80px;
  max-width: 1440px; margin: 0 auto;
  display: grid; grid-template-columns: 1fr 1fr; gap: 48px;
  align-items: start;
">

  <!-- Left: info -->
  <div class="reveal">
    <p style="
      font-family: 'Inter', system-ui, sans-serif;
      font-size: 10px; font-weight: 500;
      letter-spacing: -0.01em; color: #9b9b9b; margin-bottom: 12px;
    ">Dónde estamos</p>

    <h2 style="
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-size: clamp(28px, 4vw, 42px); font-weight: 400;
      line-height: 1.05; letter-spacing: -0.02em; color: #000; margin: 0 0 32px;
    ">Ven a vernos.<br/>O escríbenos primero.</h2>

    <div style="display: flex; flex-direction: column; gap: 20px;">

      <div style="padding-bottom: 20px; border-bottom: 1px solid #000;">
        <p class="tag" style="margin-bottom: 4px;">Dirección</p>
        <p style="
          font-family: Georgia, serif; font-size: 16px;
          color: #000; line-height: 1.5; letter-spacing: -0.14px; margin: 0;
        ">Calle Real Vieja, 32<br/>28100 Alcobendas, Madrid</p>
      </div>

      <div style="padding-bottom: 20px; border-bottom: 1px solid #000;">
        <p class="tag" style="margin-bottom: 4px;">Teléfono</p>
        <a href="tel:+34611411420" style="
          font-family: Georgia, serif; font-size: 16px;
          color: #000; text-decoration: none; letter-spacing: -0.14px;
        ">611 41 14 20</a>
      </div>

      <div style="padding-bottom: 20px; border-bottom: 1px solid #000;">
        <p class="tag" style="margin-bottom: 4px;">Horario</p>
        <p style="
          font-family: Georgia, serif; font-size: 16px;
          color: #000; line-height: 1.5; letter-spacing: -0.14px; margin: 0;
        ">Abrimos a las 16:00 h<br/>
        <span style="color:#9b9b9b;">Horario completo próximamente</span></p>
      </div>

    </div>

    <a href="https://wa.me/34611411420?text=Hola,%20me%20gustaría%20consultar%20sobre%20un%20tatuaje"
       target="_blank" rel="noopener"
       class="btn-ghost" style="margin-top: 28px;">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
      </svg>
      Escribir por WhatsApp
    </a>
  </div>

  <!-- Right: Map -->
  <div class="reveal">
    <div class="img-frame" style="overflow: hidden; height: 400px;">
      <iframe
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3033.5!2d-3.6391!3d40.5424!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2sCalle+Real+Vieja+32+Alcobendas!5e0!3m2!1ses!2ses!4v1"
        width="100%" height="400"
        style="border:0; display:block;"
        allowfullscreen
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        title="Ubicación Coyote Tattoo"
      ></iframe>
    </div>
    <p class="tag" style="margin-top: 6px; padding: 0 2px;">
      Calle Real Vieja, 32 · Alcobendas ·
      <a href="https://maps.google.com/?q=Calle+Real+Vieja+32+Alcobendas+Madrid"
         target="_blank" rel="noopener" style="color:#9b9b9b; text-decoration:none;">
        Ver en Maps →
      </a>
    </p>
  </div>

  <style>
    @media (max-width: 640px) {
      section { grid-template-columns: 1fr !important; }
    }
  </style>
</section>
