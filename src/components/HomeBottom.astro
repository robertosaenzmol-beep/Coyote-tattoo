---
---

<!-- Map + Location -->
<section class="hb-section">
  <hr class="hairline" />
  <div class="map-grid reveal" data-stagger>
    <!-- Map -->
    <div class="img-frame reveal" style="overflow: hidden; height: 360px;">
      <iframe
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3033.5!2d-3.6391!3d40.5424!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2sCalle+Real+Vieja+32+Alcobendas!5e0!3m2!1ses!2ses!4v1"
        width="100%" height="360"
        style="border:0; display:block;"
        allowfullscreen
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        title="Ubicación Coyote Tattoo"
      ></iframe>
    </div>

    <!-- Info -->
    <div class="reveal">
      <p class="section-label">Encuéntranos</p>
      <h2 class="hb-heading">Calle Real Vieja, 32</h2>
      <p class="hb-address">28100 Alcobendas, Madrid</p>
      <p class="hb-hours">L-V: 11–14h / 16–20:30h · Sáb: 11–14h</p>

      <div class="hb-buttons">
        <a href="tel:+34611411420" class="btn-ghost--accent btn-ghost" data-tel-src="homebottom-call">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6A19.79 19.79 0 012.12 4.18 2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/>
          </svg>
          Llamar
        </a>
        <a href="https://maps.app.goo.gl/1BLkX6jwvPRLCYDfA" target="_blank" rel="noopener" class="btn-ghost--accent btn-ghost">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M17.657 16.657L13.414 20.9a2 2 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
            <circle cx="12" cy="11" r="3"/>
          </svg>
          Cómo llegar
        </a>
      </div>
    </div>
  </div>
</section>

<!-- Explore Cards -->
<section class="hb-section">
  <hr class="hairline" />
  <div class="hb-explore-header reveal">
    <p class="section-label">Sigue explorando</p>
    <h2 class="section-title">Echa un vistazo</h2>
  </div>

  <div class="explore-grid" data-stagger>
    <a href="/galeria" class="explore-card reveal">
      <div class="explore-card__img">
        <img src="/images/gallery/tattoo-05.webp" alt="" loading="lazy" />
      </div>
      <div class="explore-card__body">
        <p class="explore-card__title">Galería</p>
        <p class="explore-card__desc">26 tatuajes, 26 historias. Ninguno salió de un catálogo.</p>
        <span class="explore-card__cta">Ver trabajos →</span>
      </div>
    </a>

    <a href="/marta" class="explore-card reveal">
      <div class="explore-card__img">
        <img src="/images/marta-tattooing.webp" alt="" loading="lazy" style="object-position: top;" />
      </div>
      <div class="explore-card__body">
        <p class="explore-card__title">Marta</p>
        <p class="explore-card__desc">Lleva tatuando desde el 98. Si quieres saber cómo trabaja, es por aquí.</p>
        <span class="explore-card__cta">Conocer a Marta →</span>
      </div>
    </a>

    <a href="/contacto" class="explore-card reveal">
      <div class="explore-card__img">
        <img src="/images/gallery/tattoo-06.webp" alt="" loading="lazy" />
      </div>
      <div class="explore-card__body">
        <p class="explore-card__title">Contacto</p>
        <p class="explore-card__desc">Dónde estamos, cómo funciona y qué hacer después del tatuaje.</p>
        <span class="explore-card__cta">Reservar cita →</span>
      </div>
    </a>
  </div>
</section>

<!-- Ink spray decoration -->
<div class="ink-spray-divider" aria-hidden="true">
  <svg viewBox="0 0 400 30" fill="none">
    <circle cx="40" cy="15" r="2" fill="currentColor" opacity="0.12"/>
    <circle cx="80" cy="8" r="1.5" fill="currentColor" opacity="0.08"/>
    <circle cx="120" cy="20" r="3" fill="currentColor" opacity="0.1"/>
    <circle cx="160" cy="12" r="1" fill="currentColor" opacity="0.06"/>
    <circle cx="200" cy="15" r="4" fill="currentColor" opacity="0.08"/>
    <circle cx="240" cy="10" r="1.5" fill="currentColor" opacity="0.07"/>
    <circle cx="280" cy="22" r="2" fill="currentColor" opacity="0.09"/>
    <circle cx="320" cy="8" r="2.5" fill="currentColor" opacity="0.06"/>
    <circle cx="360" cy="18" r="1" fill="currentColor" opacity="0.05"/>
  </svg>
</div>

