<!-- ── Mapa + dirección ─────────────────────────────────── -->
<section style="
  padding: 80px 24px;
  max-width: 1200px; margin: 0 auto;
  border-top: 1px solid #e0e0e0;
">
  <div class="map-grid reveal" style="
    display: grid; grid-template-columns: 1fr 1fr; gap: 48px;
    align-items: center;
  ">
    <!-- Map -->
    <div class="img-frame" style="overflow: hidden; height: 360px;">
      <iframe
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3033.5!2d-3.6391!3d40.5424!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2sCalle+Real+Vieja+32+Alcobendas!5e0!3m2!1ses!2ses!4v1"
        width="100%" height="360"
        style="border:0; display:block;"
        allowfullscreen
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        title="Ubicación Coyote Tattoo"
      ></iframe>
    </div>

    <!-- Info -->
    <div>
      <p style="
        font-family: 'Inter', system-ui, sans-serif;
        font-size: 12px; font-weight: 500;
        letter-spacing: -0.01em; color: #9B4DCA;
        margin-bottom: 12px;
      ">Encuéntranos</p>
      <h2 style="
        font-family: 'Bebas Neue', Impact, sans-serif;
        font-size: clamp(28px, 4vw, 42px); font-weight: 400;
        line-height: 1.05; letter-spacing: 0.03em; color: #000; margin: 0 0 24px;
      ">Calle Real Vieja, 32</h2>
      <p style="
        font-family: 'Lora', Georgia, serif; font-size: 17px;
        color: #000; line-height: 1.6; margin: 0 0 6px;
      ">28100 Alcobendas, Madrid</p>
      <p style="
        font-family: 'Lora', Georgia, serif; font-size: 17px;
        color: #9b9b9b; line-height: 1.6; margin: 0 0 24px;
      ">L-V: 11–14h / 16–20:30h · Sáb: 11–14h</p>

      <div style="display: flex; gap: 12px; flex-wrap: wrap;">
        <a href="tel:+34611411420" class="map-btn-dark" style="
          font-family: 'Inter', system-ui, sans-serif;
          font-size: 14px; font-weight: 500;
          color: #000; text-decoration: none;
          border: 1px solid #000; border-radius: 48px;
          padding: 10px 20px; display: inline-flex; align-items: center; gap: 6px;
          transition: background 0.15s ease, color 0.15s ease;
        ">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6A19.79 19.79 0 012.12 4.18 2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/>
          </svg>
          Llamar
        </a>
        <a href="https://maps.app.goo.gl/1BLkX6jwvPRLCYDfA"
           target="_blank" rel="noopener" class="map-btn-accent" style="
          font-family: 'Inter', system-ui, sans-serif;
          font-size: 14px; font-weight: 500;
          color: #9B4DCA; text-decoration: none;
          border: 1px solid #9B4DCA; border-radius: 48px;
          padding: 10px 20px; display: inline-flex; align-items: center; gap: 6px;
          transition: background 0.15s ease, color 0.15s ease;
        ">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M17.657 16.657L13.414 20.9a2 2 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
            <circle cx="12" cy="11" r="3"/>
          </svg>
          Cómo llegar
        </a>
      </div>
    </div>
  </div>
</section>

<!-- ── Explora más — 3 links del menú ───────────────────── -->
<section style="
  padding: 80px 24px;
  max-width: 1200px; margin: 0 auto;
  border-top: 1px solid #e0e0e0;
">
  <div style="text-align: center; margin-bottom: 48px;" class="reveal">
