<style>
  .hb-section {
    padding: 80px 24px;
    max-width: 1200px;
    margin: 0 auto;
  }

  /* Map grid */
  .map-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: center;
    margin-top: 48px;
  }

  .hb-heading {
    font-family: var(--font-wordmark);
    font-size: clamp(28px, 4vw, 42px);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: 0.03em;
    color: var(--color-text-primary);
    margin: 0 0 24px;
  }
  .hb-address {
    font-family: var(--font-serif);
    font-size: 17px;
    color: var(--color-text-primary);
    line-height: 1.6;
    margin: 0 0 6px;
  }
  .hb-hours {
    font-family: var(--font-serif);
    font-size: 17px;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin: 0 0 24px;
  }
  .hb-buttons {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  /* Explore header */
  .hb-explore-header {
    text-align: center;
    margin-bottom: 48px;
    margin-top: 48px;
  }

  /* Explore grid */
  .explore-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 20px;
  }

  .explore-card {
    display: block;
    text-decoration: none;
    color: var(--color-text-primary);
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    overflow: hidden;
    transition: border-color 0.3s ease, transform 0.3s ease;
  }
  .explore-card:hover {
    border-color: var(--color-accent);
    transform: translateY(-4px);
  }

  .explore-card__img {
    height: 200px;
    overflow: hidden;
  }
  .explore-card__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }
  .explore-card:hover .explore-card__img img {
    transform: scale(1.05);
  }

  .explore-card__body {
    padding: 24px;
  }
  .explore-card__title {
    font-family: var(--font-wordmark);
    font-size: 24px;
    letter-spacing: 0.03em;
    margin: 0 0 8px;
  }
  .explore-card__desc {
    font-family: var(--font-serif);
    font-size: 15px;
    color: var(--color-text-secondary);
    line-height: 1.5;
    margin: 0;
  }
  .explore-card__cta {
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 500;
    color: var(--color-accent);
    display: inline-block;
    margin-top: 12px;
  }

  /* CTA Banner */
  .hb-cta-banner {
    padding: 64px 24px;
    background: var(--color-bg-elevated);
    text-align: center;
  }
  .hb-cta-inner {
    max-width: 600px;
    margin: 0 auto;
  }
  .hb-cta-title {
    font-family: var(--font-wordmark);
    font-size: clamp(32px, 5vw, 48px);
    font-weight: 400;
    letter-spacing: 0.04em;
    color: var(--color-text-primary);
    margin: 0 0 12px;
    line-height: 1.1;
  }
  .hb-cta-desc {
    font-family: var(--font-serif);
    font-size: 17px;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin: 0 0 32px;
  }
  .hb-cta-buttons {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 40px;
  }

  /* Social */
  .hb-social-divider {
    width: 48px;
    height: 1px;
    background: var(--color-border);
    margin: 0 auto 24px;
  }
  .hb-social-links {
    display: flex;
    gap: 24px;
    justify-content: center;
    align-items: center;
  }
  .hb-social-link {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 500;
    color: var(--color-accent);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: color 0.2s ease;
  }
  .hb-social-link:hover {
    color: var(--color-accent-light);
  }

  /* Ink spray divider */
  .ink-spray-divider {
    text-align: center;
    padding: 20px 0;
    color: var(--color-accent);
    pointer-events: none;
  }
  .ink-spray-divider svg {
    width: 100%;
    max-width: 400px;
    height: 30px;
  }

  /* CTA ink decoration */
  .ink-decor--cta {
    position: absolute;
    top: -20px;
    right: 40px;
    width: 140px;
    height: 140px;
    color: var(--color-accent);
    pointer-events: none;
    z-index: 0;
  }

  .hb-cta-banner {
    position: relative;
  }

  @media (max-width: 640px) {
    .map-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .map-grid .img-frame {
      height: 250px !important;
    }
    .explore-grid {
      grid-template-columns: 1fr;
    }
    .ink-decor--cta,
    .ink-spray-divider {
      display: none;
    }
  }
</style>
