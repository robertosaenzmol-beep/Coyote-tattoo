<!-- Hamburger button — always visible, top-right -->
<button id="mob-btn" class="nav-btn" aria-label="Menú" aria-expanded="false">
  <span id="m1" class="nav-btn__line"></span>
  <span id="m2" class="nav-btn__line"></span>
  <span id="m3" class="nav-btn__line nav-btn__line--short"></span>
</button>

<!-- Fullscreen menu overlay -->
<nav id="menu-overlay" class="menu-overlay" aria-label="Menú principal">
  <a href="/" class="menu-link">Inicio</a>
  <a href="/galeria" class="menu-link">Galería</a>
  <a href="/marta" class="menu-link">Marta</a>
  <a href="/contacto" class="menu-link">Contacto</a>

  <!-- Accent line -->
  <div class="menu-accent"></div>

  <!-- WhatsApp CTA -->
  <a
    href="https://wa.me/34611411420?text=%C2%A1Hola!%20Vengo%20desde%20vuestra%20web%20y%20quiero%20info%20para%20un%20tatuaje%20%F0%9F%99%8C%20Zona%3A%20__%20%C2%B7%20%C2%BFReferencia%3F%20S%C3%AD%2FNo.%20%C2%A1Gracias!"
    target="_blank"
    rel="noopener"
    class="menu-wa"
    data-wa-src="nav"
  >
    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
    </svg>
    Reservar cita
  </a>
</nav>

<style>
  /* Hamburger button */
  .nav-btn {
    position: fixed;
    top: max(20px, env(safe-area-inset-top));
    right: 24px;
    z-index: 60;
    display: flex;
    flex-direction: column;
    gap: 5px;
    background: rgba(10, 10, 10, 0.85);
    border: 1px solid var(--color-border);
    border-radius: 50%;
    width: 48px;
    height: 48px;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    transition: background 0.25s ease, border-color 0.25s ease;
  }
  .nav-btn__line {
    display: block;
    width: 20px;
    height: 1.5px;
    background: #fff;
    transition: all 0.3s ease;
  }
  .nav-btn__line--short {
    width: 14px;
  }
  .nav-btn.open {
    background: transparent;
    border-color: rgba(255, 255, 255, 0.3);
  }

  /* Menu overlay */
  .menu-overlay {
    position: fixed;
    inset: 0;
    z-index: 55;
    background: var(--color-bg);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s ease;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    padding: env(safe-area-inset-top) env(safe-area-inset-right) env(safe-area-inset-bottom) env(safe-area-inset-left);
  }
  .menu-overlay.open {
    opacity: 1;
    pointer-events: all;
  }

  /* Menu links with stagger */
  .menu-link {
    font-family: var(--font-wordmark);
    font-size: clamp(48px, 10vw, 80px);
    color: #fff;
    text-decoration: none;
    letter-spacing: 0.06em;
    line-height: 1.3;
    display: block;
    text-align: center;
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.4s ease, transform 0.4s ease, color 0.2s ease;
  }
  .menu-overlay.open .menu-link {
    opacity: 1;
    transform: none;
  }
  .menu-overlay.open .menu-link:nth-child(1) { transition-delay: 0.08s; }
  .menu-overlay.open .menu-link:nth-child(2) { transition-delay: 0.14s; }
  .menu-overlay.open .menu-link:nth-child(3) { transition-delay: 0.20s; }
  .menu-overlay.open .menu-link:nth-child(4) { transition-delay: 0.26s; }

  .menu-link:hover {
    color: var(--color-accent);
  }

  /* Accent line */
  .menu-accent {
    width: 60px;
    height: 3px;
    background: var(--color-accent);
    margin: 32px auto 24px;
    border-radius: 2px;
    opacity: 0;
    transition: opacity 0.4s ease 0.32s;
  }
  .menu-overlay.open .menu-accent {
    opacity: 1;
  }

  /* WhatsApp CTA in menu */
  .menu-wa {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 500;
    color: var(--color-accent);
    text-decoration: none;
    letter-spacing: 0.02em;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border: 1px solid var(--color-accent);
    border-radius: var(--radius-pill);
    padding: 14px 28px;
    min-height: 44px;
    transition: background 0.2s ease, color 0.2s ease, opacity 0.4s ease 0.36s, transform 0.4s ease 0.36s;
    opacity: 0;
    transform: translateY(12px);
  }
  .menu-overlay.open .menu-wa {
    opacity: 1;
    transform: none;
  }
  .menu-wa:hover {
    background: var(--color-accent);
    color: #fff;
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const btn     = document.getElementById('mob-btn');
    const overlay = document.getElementById('menu-overlay');
    const m1      = document.getElementById('m1');
    const m2      = document.getElementById('m2');
    const m3      = document.getElementById('m3');
    if (!btn || !overlay || !m1 || !m2 || !m3) return;

    let isOpen = false;

    function toggle() {
      isOpen = !isOpen;
      btn.setAttribute('aria-expanded', String(isOpen));
      btn.classList.toggle('open', isOpen);
      overlay.classList.toggle('open', isOpen);

      m1.style.transform = isOpen ? 'rotate(45deg) translate(4px,4px)' : '';
      m2.style.opacity   = isOpen ? '0' : '1';
      m3.style.transform = isOpen ? 'rotate(-45deg) translate(3px,-3px)' : '';
      m3.style.width     = isOpen ? '20px' : '14px';

      document.body.style.overflow = isOpen ? 'hidden' : '';
    }

    btn.addEventListener('click', toggle);
    overlay.querySelectorAll('.menu-link').forEach(l =>
      l.addEventListener('click', () => { if (isOpen) toggle(); })
    );
  });
</script>
