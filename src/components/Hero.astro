<section class="hero" id="main-content">
  <!-- Background image with cinematic overlay -->
  <div class="hero-bg">
    <img
      src="/images/gallery/tattoo-01.webp"
      alt=""
      class="hero-bg__img"
    />
    <div class="hero-overlay"></div>
  </div>

  <!-- Content -->
  <div class="hero-content reveal">
    <img
      class="hero-logo"
      src="/images/logo.webp"
      alt="Coyote Tattoo Logo"
    />

    <h1 class="hero-title">Coyote Tattoo</h1>

    <p class="hero-subtitle">
      Tatuajes a medida en Alcobendas.<br/>
      Marta lleva 27 años con la máquina.
    </p>

    <p class="hero-meta">4,6★ · 148 reseñas en Google · Calle Real Vieja, 32</p>

    <a
      href="https://wa.me/34611411420?text=%C2%A1Hola!%20Vengo%20desde%20vuestra%20web%20y%20quiero%20info%20para%20un%20tatuaje%20%F0%9F%99%8C%20Zona%3A%20__%20%C2%B7%20%C2%BFReferencia%3F%20S%C3%AD%2FNo.%20%C2%A1Gracias!"
      target="_blank"
      rel="noopener"
      class="hero-cta btn-wa"
      data-wa-src="hero"
    >
      <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
      </svg>
      Cuéntanos tu idea
    </a>
  </div>

  <!-- Ink decoration -->
  <svg class="ink-decor ink-decor--hero" viewBox="0 0 60 160" fill="none" aria-hidden="true">
    <circle cx="30" cy="20" r="4" fill="currentColor" opacity="0.15"/>
    <circle cx="25" cy="50" r="2.5" fill="currentColor" opacity="0.1"/>
    <circle cx="35" cy="75" r="6" fill="currentColor" opacity="0.08"/>
    <circle cx="28" cy="110" r="3" fill="currentColor" opacity="0.06"/>
    <circle cx="32" cy="140" r="1.5" fill="currentColor" opacity="0.05"/>
    <line x1="30" y1="0" x2="30" y2="160" stroke="currentColor" stroke-width="0.5" opacity="0.06"/>
  </svg>

  <svg class="ink-decor ink-decor--hero-r" viewBox="0 0 120 80" fill="none" aria-hidden="true">
    <circle cx="100" cy="40" r="20" fill="currentColor" opacity="0.04"/>
    <circle cx="70" cy="20" r="8" fill="currentColor" opacity="0.03"/>
    <circle cx="50" cy="60" r="5" fill="currentColor" opacity="0.025"/>
    <circle cx="110" cy="70" r="3" fill="currentColor" opacity="0.02"/>
  </svg>

  <!-- Scroll hint -->
  <div class="hero-scroll">
    <div class="hero-scroll__line"></div>
    <p class="hero-scroll__text">Scroll</p>
  </div>
</section>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 120px 24px 80px;
    position: relative;
    overflow: hidden;
  }

  /* Background + cinematic overlay */
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
  }
  .hero-bg__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.55) 0%,
      rgba(0, 0, 0, 0.4) 50%,
      rgba(10, 10, 10, 1) 100%
    );
  }

  /* Content */
  .hero-content {
    position: relative;
    z-index: 1;
    max-width: 800px;
  }

  .hero-logo {
    width: 180px;
    height: 180px;
    margin: 0 auto 40px;
    display: block;
    border-radius: 50%;
  }

  .hero-title {
    font-family: var(--font-wordmark);
    font-size: clamp(56px, 10vw, 110px);
    font-weight: 400;
    line-height: 0.95;
    letter-spacing: 0.04em;
    color: #fff;
    margin: 0 0 24px;
  }

  .hero-subtitle {
    font-family: var(--font-serif);
    font-size: clamp(16px, 2.5vw, 22px);
    line-height: 1.5;
    color: var(--color-text-secondary);
    margin: 0 0 16px;
    max-width: 520px;
    margin-left: auto;
    margin-right: auto;
  }

  .hero-meta {
    font-family: var(--font-sans);
    font-size: 13px;
    color: var(--color-text-secondary);
    letter-spacing: -0.01em;
    margin: 0 0 40px;
  }

  .hero-cta {
    animation: cta-pulse 2.5s ease-in-out infinite;
  }
  @keyframes cta-pulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(155, 77, 202, 0.4); }
    50%      { box-shadow: 0 0 0 12px rgba(155, 77, 202, 0); }
  }

  /* Scroll hint */
  .hero-scroll {
    position: absolute;
    bottom: 32px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .hero-scroll__line {
    width: 2px;
    height: 48px;
    background: linear-gradient(to bottom, transparent, var(--color-accent));
    margin-bottom: 10px;
    animation: pulse-line 1.8s ease-in-out infinite;
  }
  .hero-scroll__text {
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 500;
    color: var(--color-text-secondary);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  @keyframes pulse-line {
    0%, 100% { opacity: 0.3; transform: translateY(0); }
    50% { opacity: 1; transform: translateY(6px); }
  }

  /* Ink decorations */
  .ink-decor--hero {
    position: absolute;
    left: 40px;
    bottom: 60px;
    width: 60px;
    height: 160px;
    color: var(--color-accent);
    pointer-events: none;
    z-index: 1;
  }
  .ink-decor--hero-r {
    position: absolute;
    right: 20px;
    top: 30%;
    width: 120px;
    height: 80px;
    color: var(--color-accent);
    pointer-events: none;
    z-index: 1;
  }

  @media (max-width: 640px) {
    .hero-logo {
      width: 120px;
      height: 120px;
      margin-bottom: 28px;
    }
    .ink-decor--hero,
    .ink-decor--hero-r {
      display: none;
    }
  }
</style>

<!-- Hero title split-letter animation -->
<script>
  document.addEventListener('astro:page-load', () => {
    const title = document.querySelector('.hero-title');
    if (!title || title.hasAttribute('data-animated')) return;
    title.setAttribute('data-animated', '');

    const text = title.textContent || '';
    let charIndex = 0;
    title.innerHTML = text.split('').map(char => {
      if (char === ' ') return ' ';
      const delay = 0.3 + charIndex * 0.035;
      charIndex++;
      return `<span class="hero-letter" style="animation-delay: ${delay}s">${char}</span>`;
    }).join('');
  });
</script>

<style is:global>
  .hero-letter {
    display: inline-block;
    opacity: 0;
    transform: translateY(40px);
    animation: letter-rise 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  @keyframes letter-rise {
    to { opacity: 1; transform: none; }
  }
</style>
