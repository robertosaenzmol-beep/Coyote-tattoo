---
---

<section style="
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 120px 24px 80px;
  position: relative;
  overflow: hidden;
">

  <!-- Background tattoo image with dark overlay -->
  <div style="
    position: absolute; inset: 0; z-index: 0;
  ">
    <img
      src="/images/gallery/tattoo-01.webp"
      alt=""
      style="width: 100%; height: 100%; object-fit: cover; display: block; filter: brightness(0.15);"
    />
  </div>

  <!-- Content -->
  <div style="position: relative; z-index: 1; max-width: 800px;" class="reveal">

    <!-- Logo -->
    <img
      src="/images/logo.webp"
      alt="Coyote Tattoo Logo"
      style="width: 180px; height: 180px; margin: 0 auto 40px; display: block; border-radius: 50%;"
    />

    <!-- Title -->
    <h1 style="
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-size: clamp(48px, 8vw, 96px);
      font-weight: 400;
      line-height: 0.95;
      letter-spacing: -0.03em;
      color: #fff;
      margin: 0 0 24px;
    ">Coyote Tattoo</h1>

    <!-- Subtitle -->
    <p style="
      font-family: Georgia, serif;
      font-size: clamp(16px, 2.5vw, 22px);
      line-height: 1.5;
      color: #9b9b9b;
      margin: 0 0 16px;
      max-width: 520px;
      margin-left: auto;
      margin-right: auto;
    ">
      Estudio de tatuajes en Alcobendas, Madrid.<br/>
      Cada pieza es única. Desde 1998.
    </p>

    <!-- Meta -->
    <p style="
      font-family: 'Inter', system-ui, sans-serif;
      font-size: 13px;
      color: #666;
      letter-spacing: -0.01em;
      margin: 0 0 40px;
    ">4,6★ · 148 reseñas en Google · Calle Real Vieja, 32</p>

    <!-- CTA -->
    <a href="https://wa.me/34611411420?text=Hola,%20me%20gustaría%20consultar%20sobre%20un%20tatuaje"
       target="_blank" rel="noopener"
       style="
        display: inline-flex;
        align-items: center;
        gap: 8px;
        border: 1px solid #fff;
        border-radius: 48px;
        padding: 14px 28px;
        font-family: 'Inter', system-ui, sans-serif;
        font-size: 14px;
        font-weight: 500;
        color: #fff;
        background: transparent;
        text-decoration: none;
        transition: background 0.2s ease, color 0.2s ease;
        letter-spacing: -0.01em;
       "
       onmouseover="this.style.background='#fff';this.style.color='#000'"
       onmouseout="this.style.background='transparent';this.style.color='#fff'"
    >
      <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
      </svg>
      Consulta gratuita
    </a>
  </div>

  <!-- Scroll hint -->
  <div style="
    position: absolute;
    bottom: 32px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 1;
  ">
    <div style="
      width: 1px; height: 40px;
      background: linear-gradient(to bottom, transparent, #666);
      margin: 0 auto 8px;
      animation: pulse-line 2s ease-in-out infinite;
    "></div>
    <p style="
      font-family: 'Inter', system-ui, sans-serif;
      font-size: 10px; color: #666;
      letter-spacing: 0.1em; text-transform: uppercase;
    ">Scroll</p>
  </div>
</section>

<style>
  @keyframes pulse-line {
    0%, 100% { opacity: 0.3; }
    50% { opacity: 1; }
  }
</style>
