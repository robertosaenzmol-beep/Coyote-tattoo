---
const reviews = [
  { name: 'María G.',      stars: 5, text: 'Diseño exactamente como lo quería. Equipo muy profesional y atento.' },
  { name: 'Carlos M.',     stars: 5, text: 'Mi tercer tatuaje en Coyote y siempre repito. Acabado perfecto.' },
  { name: 'Laura P.',      stars: 5, text: 'Primera vez tatuándome, me hicieron sentir muy cómoda. Volveré.' },
  { name: 'Alejandro R.',  stars: 5, text: 'Diseño original, higiene impecable, trato muy cercano.' },
  { name: 'Sofía L.',      stars: 4, text: 'Gran trabajo. El estudio es acogedor y el equipo muy amable.' },
  { name: 'Daniel T.',     stars: 5, text: 'Sin duda el mejor estudio de la zona. Se nota la experiencia.' },
];

function stars(n: number) {
  return '★'.repeat(n) + '☆'.repeat(5 - n);
}
---

<section id="resenas" style="
  padding: 64px 24px;
  max-width: 1440px; margin: 0 auto;
  border-top: 1px solid #000;
">

  <!-- Header row -->
  <div style="
    display: flex; align-items: flex-end; justify-content: space-between;
    margin-bottom: 32px; gap: 16px; flex-wrap: wrap;
  " class="reveal">
    <div>
      <p style="
        font-family: 'Inter', system-ui, sans-serif;
        font-size: 10px; font-weight: 500;
        letter-spacing: -0.01em; color: #9b9b9b; margin-bottom: 8px;
      ">Reseñas</p>
      <p style="
        font-family: 'Cormorant Garamond', Georgia, serif;
        font-size: clamp(28px, 4vw, 42px); font-weight: 400;
        line-height: 1.05; letter-spacing: -0.02em; color: #000; margin: 0;
      ">4,6★ en Google.<br/>148 personas que volvieron a contarlo.</p>
    </div>
    <a href="https://g.page/r/coyotetattoo/review" target="_blank" rel="noopener" style="
      font-family: 'Inter', system-ui, sans-serif;
      font-size: 14px; color: #9b9b9b; text-decoration: none; letter-spacing: -0.14px;
      white-space: nowrap; align-self: flex-end;
    ">Ver en Google →</a>
  </div>

  <!-- Reviews grid -->
  <div style="
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1px; background: #000;
    border: 1px solid #000; border-radius: 10px; overflow: hidden;
  ">
    {reviews.map((r, i) => (
      <div class="reveal" style="
        background: #fff; padding: 20px;
      ">
        <p style="
          font-family: Georgia, serif; font-size: 12px;
          color: #000; margin-bottom: 8px; letter-spacing: 0.05em;
        ">{stars(r.stars)}</p>
        <p style="
          font-family: Georgia, serif; font-size: 14px;
          color: #000; line-height: 1.5; letter-spacing: -0.14px;
          margin-bottom: 12px;
        ">"{r.text}"</p>
        <p class="tag" style="margin: 0;">{r.name}</p>
      </div>
    ))}
  </div>
</section>
