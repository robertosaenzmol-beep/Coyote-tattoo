---
const tattoos = [
  { src: '/images/gallery/tattoo-01.webp', alt: 'Tatuaje' },
  { src: '/images/gallery/tattoo-02.webp', alt: 'Tatuaje' },
  { src: '/images/gallery/tattoo-03.webp', alt: 'Tatuaje' },
  { src: '/images/gallery/tattoo-04.webp', alt: 'Tatuaje' },
  { src: '/images/gallery/tattoo-05.webp', alt: 'Tatuaje' },
  { src: '/images/gallery/tattoo-06.webp', alt: 'Tatuaje' },
  { src: '/images/gallery/tattoo-07.webp', alt: 'Tatuaje' },
  { src: '/images/gallery/tattoo-08.webp', alt: 'Tatuaje' },
  { src: '/images/gallery/tattoo-09.webp', alt: 'Tatuaje' },
  { src: '/images/gallery/tattoo-10.webp', alt: 'Tatuaje' },
  { src: '/images/gallery/tattoo-11.webp', alt: 'Tatuaje' },
  { src: '/images/gallery/tattoo-12.webp', alt: 'Tatuaje' },
  { src: '/images/gallery/tattoo-13.webp', alt: 'Tatuaje' },
  { src: '/images/gallery/tattoo-14.webp', alt: 'Tatuaje' },
  { src: '/images/gallery/tattoo-15.webp', alt: 'Tatuaje' },
  { src: '/images/gallery/tattoo-16.webp', alt: 'Tatuaje' },
  { src: '/images/gallery/tattoo-17.webp', alt: 'Tatuaje' },
  { src: '/images/gallery/tattoo-18.webp', alt: 'Tatuaje' },
  { src: '/images/gallery/tattoo-19.webp', alt: 'Tatuaje' },
  { src: '/images/gallery/tattoo-20.webp', alt: 'Tatuaje' },
  { src: '/images/gallery/tattoo-21.webp', alt: 'Tatuaje' },
  { src: '/images/gallery/tattoo-22.webp', alt: 'Tatuaje' },
  { src: '/images/gallery/tattoo-23.webp', alt: 'Tatuaje' },
  { src: '/images/gallery/tattoo-24.webp', alt: 'Tatuaje' },
  { src: '/images/gallery/tattoo-25.webp', alt: 'Tatuaje' },
  { src: '/images/gallery/tattoo-26.webp', alt: 'Tatuaje' },
];
---

<section id="trabajo" class="gallery-section">
  <!-- Ink decoration -->
  <svg class="ink-decor ink-decor--gallery-tl" viewBox="0 0 80 120" fill="none" aria-hidden="true">
    <circle cx="50" cy="30" r="18" fill="currentColor" opacity="0.07"/>
    <circle cx="25" cy="60" r="10" fill="currentColor" opacity="0.05"/>
    <circle cx="60" cy="85" r="6" fill="currentColor" opacity="0.04"/>
    <circle cx="15" cy="95" r="3" fill="currentColor" opacity="0.03"/>
  </svg>

  <!-- Section header -->
  <div class="gallery-header reveal">
    <p class="section-label">Trabajo reciente</p>
    <h2 class="section-title">Esto es lo que hacemos</h2>
    <a href="/galeria" class="gallery-link">Ver todo →</a>
  </div>

  <!-- Auto-scrolling carousel -->
  <div class="tattoo-carousel">
    {tattoos.map((t, i) => (
      <div class="tattoo-card">
        <img src={t.src} alt={t.alt} loading={i < 4 ? 'eager' : 'lazy'} />
      </div>
    ))}
    {tattoos.map((t) => (
      <div class="tattoo-card" aria-hidden="true">
        <img src={t.src} alt="" loading="lazy" />
      </div>
    ))}
  </div>
</section>

<style>
  .gallery-section {
    padding: 80px 0;
    max-width: 1440px;
    margin: 0 auto;
    overflow: hidden;
    position: relative;
  }

  .gallery-header {
    padding: 0 24px;
    margin-bottom: 40px;
    text-align: center;
  }

  .gallery-link {
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 500;
    color: var(--color-accent);
    text-decoration: none;
    letter-spacing: -0.01em;
    transition: color 0.2s ease;
  }
  .gallery-link:hover {
    color: var(--color-accent-light);
  }

  /* Carousel */
  .tattoo-carousel {
    display: flex;
    gap: 0;
    width: max-content;
    animation: scroll-tattoos 90s linear infinite;
    will-change: transform;
  }
  .tattoo-card {
    flex-shrink: 0;
    margin-right: 14px;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    width: 320px;
    height: 400px;
    transition: border-color 0.3s ease;
  }
  .tattoo-card:hover {
    border-color: var(--color-accent);
  }
  .tattoo-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }
  .tattoo-card:hover img {
    transform: scale(1.03);
  }

  @keyframes scroll-tattoos {
    0%   { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  /* Dark fade edges */
  .gallery-section::before,
  .gallery-section::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: 80px;
    z-index: 2;
    pointer-events: none;
  }
  .gallery-section::before {
    left: 0;
    background: linear-gradient(to right, var(--color-bg), transparent);
  }
  .gallery-section::after {
    right: 0;
    background: linear-gradient(to left, var(--color-bg), transparent);
  }

  /* Ink decoration */
  .ink-decor--gallery-tl {
    position: absolute;
    top: 20px;
    right: 40px;
    width: 80px;
    height: 120px;
    color: var(--color-accent);
    pointer-events: none;
    z-index: 0;
  }

  @media (max-width: 640px) {
    .tattoo-card {
      width: 240px;
      height: 300px;
    }
    .gallery-section::before,
    .gallery-section::after {
      width: 30px;
    }
    .ink-decor--gallery-tl {
      display: none;
    }
  }
</style>
