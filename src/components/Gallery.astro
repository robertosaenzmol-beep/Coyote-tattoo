---
const tattoos = [
  { src: '/images/gallery/tattoo-01.webp', alt: 'Tatuaje', tags: ['#tatuaje', '#alcobendas'] },
  { src: '/images/gallery/tattoo-02.webp', alt: 'Tatuaje', tags: ['#diseño', '#personalizado'] },
  { src: '/images/gallery/tattoo-03.webp', alt: 'Tatuaje', tags: ['#tatuaje', '#madrid'] },
  { src: '/images/gallery/tattoo-04.webp', alt: 'Tatuaje', tags: ['#diseño', '#tinta'] },
  { src: '/images/gallery/tattoo-05.webp', alt: 'Tatuaje', tags: ['#tatuaje', '#arte'] },
  { src: '/images/gallery/tattoo-06.webp', alt: 'Tatuaje', tags: ['#tinta', '#personalizado'] },
  { src: '/images/gallery/tattoo-07.webp', alt: 'Tatuaje', tags: ['#diseño', '#alcobendas'] },
  { src: '/images/gallery/tattoo-08.webp', alt: 'Tatuaje', tags: ['#tatuaje', '#madrid'] },
  { src: '/images/gallery/tattoo-09.webp', alt: 'Tatuaje', tags: ['#diseño', '#personalizado'] },
  { src: '/images/gallery/tattoo-10.webp', alt: 'Tatuaje', tags: ['#tatuaje', '#arte'] },
  { src: '/images/gallery/tattoo-11.webp', alt: 'Tatuaje', tags: ['#tinta', '#alcobendas'] },
  { src: '/images/gallery/tattoo-12.webp', alt: 'Tatuaje', tags: ['#diseño', '#madrid'] },
  { src: '/images/gallery/tattoo-13.webp', alt: 'Tatuaje', tags: ['#tatuaje', '#personalizado'] },
  { src: '/images/gallery/tattoo-14.webp', alt: 'Tatuaje', tags: ['#tinta', '#arte'] },
  { src: '/images/gallery/tattoo-15.webp', alt: 'Tatuaje', tags: ['#diseño', '#alcobendas'] },
  { src: '/images/gallery/tattoo-16.webp', alt: 'Tatuaje', tags: ['#tatuaje', '#tinta'] },
  { src: '/images/gallery/tattoo-17.webp', alt: 'Tatuaje', tags: ['#diseño', '#madrid'] },
  { src: '/images/gallery/tattoo-18.webp', alt: 'Tatuaje', tags: ['#tatuaje', '#personalizado'] },
  { src: '/images/gallery/tattoo-19.webp', alt: 'Tatuaje', tags: ['#tinta', '#arte'] },
  { src: '/images/gallery/tattoo-20.webp', alt: 'Tatuaje', tags: ['#diseño', '#alcobendas'] },
  { src: '/images/gallery/tattoo-21.webp', alt: 'Tatuaje', tags: ['#tatuaje', '#madrid'] },
  { src: '/images/gallery/tattoo-22.webp', alt: 'Tatuaje', tags: ['#diseño', '#tinta'] },
  { src: '/images/gallery/tattoo-23.webp', alt: 'Tatuaje', tags: ['#tatuaje', '#arte'] },
  { src: '/images/gallery/tattoo-24.webp', alt: 'Tatuaje', tags: ['#tinta', '#personalizado'] },
  { src: '/images/gallery/tattoo-25.webp', alt: 'Tatuaje', tags: ['#diseño', '#madrid'] },
  { src: '/images/gallery/tattoo-26.webp', alt: 'Tatuaje', tags: ['#tatuaje', '#alcobendas'] },
];
---

<section id="trabajo" style="padding: 32px 24px 80px; max-width: 1440px; margin: 0 auto;">

  <!-- Section label -->
  <p style="
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 10px; font-weight: 500;
    letter-spacing: -0.01em; color: #9b9b9b;
    margin-bottom: 20px;
  ">Trabajo reciente</p>

  <!-- Masonry grid -->
  <div class="masonry">

    {tattoos.map((t, i) => (
      <div class="masonry-item reveal">
        <!-- Thumbnail with hairline border -->
        <div class="img-frame thumb-wrap"
             role="button" tabindex="0"
             data-index={i}
             aria-label={`Ver ${t.alt}`}
             style="cursor: pointer;">
          <img src={t.src} alt={t.alt} loading={i < 3 ? 'eager' : 'lazy'} />
        </div>
        <!-- Title + tags below image -->
        <div style="margin-top: 6px; padding: 0 2px;">
          <p style="
            font-family: Georgia, serif;
            font-size: 14px; line-height: 1.2;
            letter-spacing: -0.14px; color: #000;
            margin: 0 0 4px;
          ">Coyote Tattoo</p>
          <p class="tag" style="margin: 0;">
            {t.tags.join(' ')}
          </p>
        </div>
      </div>
    ))}

    <!-- About text block (mixed grid cell) -->
    <div class="masonry-item reveal" id="nosotros" style="
      border: 1px solid #000; border-radius: 10px;
      padding: 20px; background: #fff;
    ">
      <p style="
        font-family: Georgia, serif; font-size: 14px;
        color: #000; margin-bottom: 12px; line-height: 1;
      ">Sobre nosotros</p>
      <p style="
        font-family: Georgia, serif; font-size: 14px;
        line-height: 1.5; letter-spacing: -0.14px; color: #000;
        margin-bottom: 16px;
      ">
        Coyote Tattoo es un estudio en Alcobendas, Madrid.
        No repetimos diseños. Cada pieza parte de una conversación
        real con el cliente.
      </p>
      <div style="display: flex; gap: 24px; margin-bottom: 16px;">
        <div>
          <p style="font-family: 'Cormorant Garamond',Georgia,serif; font-size: 28px; color:#000; line-height:1; margin:0;">148</p>
          <p class="tag" style="margin:2px 0 0;">reseñas Google</p>
        </div>
        <div>
          <p style="font-family: 'Cormorant Garamond',Georgia,serif; font-size: 28px; color:#000; line-height:1; margin:0;">4,6★</p>
          <p class="tag" style="margin:2px 0 0;">valoración media</p>
        </div>
      </div>
      <a href="#contacto" style="
        font-family: 'Inter', system-ui, sans-serif;
        font-size: 14px; color: #9b9b9b; text-decoration: none;
        letter-spacing: -0.14px;
      ">Ver más →</a>
    </div>

    <!-- Process mini block -->
    <div class="masonry-item reveal" id="proceso" style="
      border: 1px solid #000; border-radius: 10px;
      padding: 20px; background: #f2f2f2;
    ">
      <p style="
        font-family: Georgia, serif; font-size: 14px;
        color: #000; margin-bottom: 16px; line-height: 1;
      ">Cómo funciona</p>
      {[
        { n: '01', t: 'Consulta', d: 'Cuéntanos tu idea por WhatsApp o en el estudio. Sin compromiso.' },
        { n: '02', t: 'Diseño',   d: 'Preparamos un diseño a medida. Lo revisamos juntos hasta que sea exactamente lo que buscas.' },
        { n: '03', t: 'Tu cita', d: 'Te tatuamos con los máximos estándares de higiene. Te explicamos el cuidado posterior.' },
      ].map(step => (
        <div style="margin-bottom: 14px; padding-bottom: 14px; border-bottom: 1px solid #9b9b9b;">
          <p style="
            font-family: Georgia, serif; font-size: 10px;
            color: #9b9b9b; margin: 0 0 2px;
          ">{step.n}</p>
          <p style="
            font-family: Georgia, serif; font-size: 14px;
            color: #000; font-weight: 400; margin: 0 0 4px;
            line-height: 1.2; letter-spacing: -0.14px;
          ">{step.t}</p>
          <p style="
            font-family: Georgia, serif; font-size: 14px;
            color: #9b9b9b; margin: 0;
            line-height: 1.4; letter-spacing: -0.14px;
          ">{step.d}</p>
        </div>
      ))}
      <a href="https://wa.me/34611411420?text=Hola,%20me%20gustaría%20reservar"
         target="_blank" rel="noopener" class="btn-ghost" style="margin-top: 4px; font-size: 10px;">
        Empezar
      </a>
    </div>

  </div>
</section>

<!-- Lightbox -->
<div id="lightbox" style="
  position: fixed; inset: 0; z-index: 100;
  background: rgba(255,255,255,0.97);
  display: flex; align-items: center; justify-content: center;
  opacity: 0; pointer-events: none;
  transition: opacity 0.25s ease;
">
  <button id="lb-close" aria-label="Cerrar" style="
    position: absolute; top: 20px; right: 24px;
    background: none; border: none; cursor: pointer;
    font-family: Georgia, serif; font-size: 14px; color: #9b9b9b;
  ">Cerrar ×</button>

  <button id="lb-prev" aria-label="Anterior" style="
    position: absolute; left: 20px;
    background: none; border: none; cursor: pointer; padding: 8px;
  ">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#000" stroke-width="1.5">
      <path d="M15 19l-7-7 7-7"/>
    </svg>
  </button>

  <img id="lb-img" src="" alt="" style="
    max-height: 85vh; max-width: 80vw; object-fit: contain;
    border: 1px solid #000; border-radius: 10px;
  "/>

  <button id="lb-next" aria-label="Siguiente" style="
    position: absolute; right: 20px;
    background: none; border: none; cursor: pointer; padding: 8px;
  ">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#000" stroke-width="1.5">
      <path d="M9 5l7 7-7 7"/>
    </svg>
  </button>

  <p id="lb-count" style="
    position: absolute; bottom: 20px;
    font-family: Georgia, serif; font-size: 14px; color: #9b9b9b;
    letter-spacing: -0.14px;
  "></p>
</div>

<script>
  const imgs = [
    '/images/gallery/tattoo-01.webp',
    '/images/gallery/tattoo-02.webp',
    '/images/gallery/tattoo-03.webp',
    '/images/gallery/tattoo-04.webp',
    '/images/gallery/tattoo-05.webp',
    '/images/gallery/tattoo-06.webp',
    '/images/gallery/tattoo-07.webp',
    '/images/gallery/tattoo-08.webp',
    '/images/gallery/tattoo-09.webp',
    '/images/gallery/tattoo-10.webp',
    '/images/gallery/tattoo-11.webp',
    '/images/gallery/tattoo-12.webp',
    '/images/gallery/tattoo-13.webp',
    '/images/gallery/tattoo-14.webp',
    '/images/gallery/tattoo-15.webp',
    '/images/gallery/tattoo-16.webp',
    '/images/gallery/tattoo-17.webp',
    '/images/gallery/tattoo-18.webp',
    '/images/gallery/tattoo-19.webp',
    '/images/gallery/tattoo-20.webp',
    '/images/gallery/tattoo-21.webp',
    '/images/gallery/tattoo-22.webp',
    '/images/gallery/tattoo-23.webp',
    '/images/gallery/tattoo-24.webp',
    '/images/gallery/tattoo-25.webp',
    '/images/gallery/tattoo-26.webp',
  ];
  let cur = 0;
  const lb    = document.getElementById('lightbox')!;
  const lbImg = document.getElementById('lb-img') as HTMLImageElement;
  const lbCnt = document.getElementById('lb-count')!;

  function open(i: number) {
    cur = i;
    lbImg.src = imgs[cur];
    lbCnt.textContent = `${cur + 1} / ${imgs.length}`;
    lb.style.opacity = '1';
    lb.style.pointerEvents = 'all';
    document.body.style.overflow = 'hidden';
  }
  function close() {
    lb.style.opacity = '0';
    lb.style.pointerEvents = 'none';
    document.body.style.overflow = '';
  }
  function prev() { open((cur - 1 + imgs.length) % imgs.length); }
  function next() { open((cur + 1) % imgs.length); }

  document.querySelectorAll('[data-index]').forEach(el => {
    const i = parseInt((el as HTMLElement).dataset.index!);
    el.addEventListener('click', () => open(i));
    el.addEventListener('keydown', (e) => { if ((e as KeyboardEvent).key === 'Enter') open(i); });
  });

  document.getElementById('lb-close')!.addEventListener('click', close);
  document.getElementById('lb-prev')!.addEventListener('click', prev);
  document.getElementById('lb-next')!.addEventListener('click', next);
  lb.addEventListener('click', (e) => { if (e.target === lb) close(); });
  document.addEventListener('keydown', (e) => {
    if (lb.style.opacity === '0') return;
    if (e.key === 'Escape') close();
    if (e.key === 'ArrowLeft') prev();
    if (e.key === 'ArrowRight') next();
  });
</script>
