---
const tattoos = [
  { src: '/images/gallery/tattoo-01.webp', alt: 'Tatuaje' },
  { src: '/images/gallery/tattoo-02.webp', alt: 'Tatuaje' },
  { src: '/images/gallery/tattoo-03.webp', alt: 'Tatuaje' },
  { src: '/images/gallery/tattoo-04.webp', alt: 'Tatuaje' },
  { src: '/images/gallery/tattoo-05.webp', alt: 'Tatuaje' },
  { src: '/images/gallery/tattoo-06.webp', alt: 'Tatuaje' },
  { src: '/images/gallery/tattoo-07.webp', alt: 'Tatuaje' },
  { src: '/images/gallery/tattoo-08.webp', alt: 'Tatuaje' },
  { src: '/images/gallery/tattoo-09.webp', alt: 'Tatuaje' },
  { src: '/images/gallery/tattoo-10.webp', alt: 'Tatuaje' },
  { src: '/images/gallery/tattoo-11.webp', alt: 'Tatuaje' },
  { src: '/images/gallery/tattoo-12.webp', alt: 'Tatuaje' },
  { src: '/images/gallery/tattoo-13.webp', alt: 'Tatuaje' },
  { src: '/images/gallery/tattoo-14.webp', alt: 'Tatuaje' },
  { src: '/images/gallery/tattoo-15.webp', alt: 'Tatuaje' },
  { src: '/images/gallery/tattoo-16.webp', alt: 'Tatuaje' },
  { src: '/images/gallery/tattoo-17.webp', alt: 'Tatuaje' },
  { src: '/images/gallery/tattoo-18.webp', alt: 'Tatuaje' },
  { src: '/images/gallery/tattoo-19.webp', alt: 'Tatuaje' },
  { src: '/images/gallery/tattoo-20.webp', alt: 'Tatuaje' },
  { src: '/images/gallery/tattoo-21.webp', alt: 'Tatuaje' },
  { src: '/images/gallery/tattoo-22.webp', alt: 'Tatuaje' },
  { src: '/images/gallery/tattoo-23.webp', alt: 'Tatuaje' },
  { src: '/images/gallery/tattoo-24.webp', alt: 'Tatuaje' },
  { src: '/images/gallery/tattoo-25.webp', alt: 'Tatuaje' },
  { src: '/images/gallery/tattoo-26.webp', alt: 'Tatuaje' },
];
---

<section id="trabajo" style="padding: 80px 0; max-width: 1440px; margin: 0 auto; overflow: hidden;">

  <!-- Section header -->
  <div style="padding: 0 24px; margin-bottom: 40px; text-align: center;" class="reveal">
    <p style="
      font-family: 'Inter', system-ui, sans-serif;
      font-size: 12px; font-weight: 500;
      letter-spacing: -0.01em; color: #9B4DCA;
      margin-bottom: 12px;
    ">Trabajo reciente</p>
    <h2 style="
      font-family: 'Bebas Neue', Impact, sans-serif;
      font-size: clamp(32px, 5vw, 52px); font-weight: 400;
      line-height: 1.05; letter-spacing: 0.03em; color: #000; margin: 0 0 16px;
    ">Esto es lo que hacemos</h2>
    <a href="/galeria" style="
      font-family: 'Inter', system-ui, sans-serif;
      font-size: 13px; font-weight: 500;
      color: #9B4DCA; text-decoration: none;
      letter-spacing: -0.01em;
    ">Ver todo →</a>
  </div>

  <!-- Auto-scrolling carousel -->
  <div class="tattoo-carousel" style="
    display: flex;
    gap: 0;
    width: max-content;
    animation: scroll-tattoos 90s linear infinite;
  ">
    {/* Original set */}
    {tattoos.map((t, i) => (
      <div class="tattoo-card" style="
        flex-shrink: 0;
        margin-right: 14px;
        overflow: hidden;
        border: 1px solid #000;
        border-radius: 10px;
        width: 300px; height: 380px;
      ">
        <img src={t.src} alt={t.alt}
             loading={i < 4 ? 'eager' : 'lazy'}
             style="width: 100%; height: 100%; object-fit: cover; display: block;" />
      </div>
    ))}
    {/* Duplicate for seamless loop */}
    {tattoos.map((t) => (
      <div class="tattoo-card" style="
        flex-shrink: 0;
        margin-right: 14px;
        overflow: hidden;
        border: 1px solid #000;
        border-radius: 10px;
        width: 300px; height: 380px;
      " aria-hidden="true">
        <img src={t.src} alt=""
             loading="lazy"
             style="width: 100%; height: 100%; object-fit: cover; display: block;" />
      </div>
    ))}
  </div>
</section>

<style>
  @keyframes scroll-tattoos {
    0%   { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  .tattoo-carousel:hover {
    animation-play-state: paused;
  }

  /* Fade edges */
  #trabajo {
    position: relative;
  }
  #trabajo::before,
  #trabajo::after {
    content: '';
    position: absolute;
    top: 0; bottom: 0;
    width: 80px;
    z-index: 2;
    pointer-events: none;
  }
  #trabajo::before {
    left: 0;
    background: linear-gradient(to right, #fff, transparent);
  }
  #trabajo::after {
    right: 0;
    background: linear-gradient(to left, #fff, transparent);
  }

  @media (max-width: 640px) {
    .tattoo-card {
      width: 240px !important;
      height: 300px !important;
    }
    #trabajo::before,
    #trabajo::after {
      width: 30px;
    }
  }
</style>
